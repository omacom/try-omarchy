prepare() {
	ln -sf hyprland-source "$_archive"
	cd "$_archive"
	# Backport of hyprwm/Hyprland#16343; drop once the packaged release includes it
	patch -Np1 --fuzz=0 -i "$srcdir/software-renderer.patch"
	# Release the EGL context before teardown; NVIDIA's EGL crashes on exit otherwise
	patch -Np1 --fuzz=0 -i "$srcdir/nvidia-egl-teardown.patch"
	# Destroying a wl_output global that clients may still be binding kills every client
	# when a dock's output flaps; wait before destroying it, as wlroots does
	patch -Np1 --fuzz=0 -i "$srcdir/wl-output-global-grace.patch"
	# A reload ignored a monitor rule's vrr unless something else about the rule changed
	patch -Np1 --fuzz=0 -i "$srcdir/monitor-rule-vrr.patch"
	patch -Np1 --fuzz=0 -i "$srcdir/client-sdr-white.patch"
	patch -Np1 --fuzz=0 -i "$srcdir/hdr-content-peak.patch"
	sed -i -e '/^release:/{n;s/-D/-DCMAKE_SKIP_RPATH=ON -D/}' Makefile
	sed -i -e '/find_package.glaze/s/7...<8 //' {.,hyprpm,start}/CMakeLists.txt
}

build() {
	cd "$_archive"
	make release PREFIX=/usr CMAKE_BUILD_PARALLEL_LEVEL=4
}

package_hyprland() {
	cd "$_archive"
	make DESTDIR="$pkgdir" install
	rm -fv "$pkgdir/usr/include/hyprland/src/version.h.in"
	find $pkgdir -name '*hyprpm*' -delete
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}

package_hyprpm() {
	pkgdesc='Plugin manager for Hyprland'
	depends=(cmake
	         cpio
	         glaze
	         hyprland
	         hyprland-protocols
	         hyprwayland-scanner
	         meson)
	cd "$_archive"
	make DESTDIR="$pkgdir" install
	find $pkgdir -type f,l -not -name '*hyprpm*' -delete
	find $pkgdir -type d -empty -delete
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
