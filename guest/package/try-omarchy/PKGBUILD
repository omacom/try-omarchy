# Maintainer: Try Omarchy <https://github.com/omacom/try-omarchy>
#
# Everything Try Omarchy adds to a stock aarch64 Omarchy install running in
# the Mac app's VM: the host bridges (clipboard, audio, camera, battery, time
# zone, Touch ID, settings), the Mac shared folder, the launcher's per-boot
# settings, and the Hyprland display and input profile for the VM. It never
# edits a file another package owns; see guest/package/README.md.

pkgname=try-omarchy
pkgver=0.1.0
pkgrel=29
pkgdesc='Mac host integration for Omarchy running in Try Omarchy'
arch=('aarch64')
url='https://github.com/omacom/try-omarchy'
license=('MIT' 'GPL-2.0-only')
# The app installs this package at a VM's boot (package-install) from its own
# copy, with no guarantee of network or a current package database. A new
# entry here would have to be downloaded then and could fail the whole
# upgrade, so add what the guest needs to optdepends: the factory image
# installs those.
depends=(
  'bash'
  'dkms'
  'fcitx5-chewing'
  'fcitx5-hangul'
  'fcitx5-mozc'
  'gtk3'
  'linux-omarchy-headers'
  'noto-fonts-cjk'
  'openssl'
  'polkit'
  'python'
  'python-gobject'
  'systemd'
  'v4l2loopback-dkms'
)
optdepends=(
  'wf-recorder: screen recording, where gpu-screen-recorder refuses VirGL'
)
backup=(
  'etc/chromium-flags.conf'
  'etc/limine-entry-tool.d/50-try-omarchy-console.conf'
  'etc/limine-entry-tool.d/50-try-omarchy-cpu.conf'
  'etc/systemd/sleep.conf.d/omarchy-sleep-disabled.conf'
)
install=try-omarchy.install
options=('!debug' '!strip')
_battery=try-omarchy-battery
_battery_version=1.3.0

package() {
  (cd "$startdir/hdr-driver" && sha256sum -c SHA256SUMS)
  cp -r --preserve=mode "$startdir/files/." "$pkgdir/"
  chmod 0750 "$pkgdir/etc/sudoers.d"
  chmod 0440 "$pkgdir/etc/sudoers.d/"*
  # Watched by the launcher from login; ghostty-desktop-entry links into it.
  install -d "$pkgdir/usr/share/try-omarchy/xdg/applications"
  for _file in dkms.conf Makefile "$_battery.c"; do
    install -Dm0644 "$startdir/battery/$_file" "$pkgdir/usr/src/$_battery-$_battery_version/$_file"
  done
  install -d "$pkgdir/usr/src/try-omarchy-virtio-gpu-hdr-1.0.0"
  install -m0644 "$startdir/hdr-driver/"* "$pkgdir/usr/src/try-omarchy-virtio-gpu-hdr-1.0.0/"
  install -d "$pkgdir/usr/share/try-omarchy/hdr"
  install -m0644 "$startdir/hdr-packages/"* "$pkgdir/usr/share/try-omarchy/hdr/"
  install -Dm0644 "$startdir/hdr-driver/COPYING" "$pkgdir/usr/share/licenses/$pkgname/Linux-GPL-2.0"
  install -d "$pkgdir/etc/fonts/conf.d"
  ln -s /usr/share/fontconfig/conf.default/30-try-omarchy.conf "$pkgdir/etc/fonts/conf.d/30-try-omarchy.conf"
  # Omarchy reads a platform's camera cutouts here; generic aarch64 has no
  # platform package, and the Mac's notch is known only at boot (host-config).
  install -d "$pkgdir/usr/share/omarchy-platform"
  ln -s /run/try-omarchy/display-cutouts.json "$pkgdir/usr/share/omarchy-platform/display-cutouts.json"
  install -Dm0644 "$startdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  printf '%s\n' "$pkgver-$pkgrel" >"$pkgdir/usr/share/try-omarchy/version"
}
