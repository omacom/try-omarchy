#!/bin/bash
#
# Export this home, encrypted, for the Omarchy installer on the Mac to bring
# to a native Omarchy install. Asks for a transfer passphrase, then runs the
# root half (export-home) through sudo, which needs no password for it
# (sudoers.d/try-omarchy-export), with the passphrase on its stdin. The
# passphrase never leaves the guest. At a terminal, it then offers to shut
# Omarchy down, which saves the export on the Mac.

set -euo pipefail

helper=${TRY_OMARCHY_EXPORT_HELPER:-/usr/lib/try-omarchy/export-home}
sudo=${TRY_OMARCHY_SUDO-sudo}
gum=${TRY_OMARCHY_GUM-$(command -v gum || true)}
interactive=${TRY_OMARCHY_INTERACTIVE-$([[ -t 0 ]] && echo 1 || true)}
virtio_root=${TRY_OMARCHY_VIRTIO_ROOT:-/sys/bus/virtio/drivers/9pnet_virtio}
minimum=12

has_share() {
  local device
  for device in "$virtio_root"/virtio*; do
    [[ -r $device/mount_tag && $(tr -d '\0' <"$device/mount_tag") == "$1" ]] && return 0
  done
  return 1
}

if ! has_share tryomarchy-native-exports; then
  echo "Only the Omarchy installer takes an export. Start Omarchy from an up-to-date Omarchy installer and try again."
  exit 1
fi

cat <<EOF
Move to a native install

This saves an encrypted copy of your configuration, files and projects for the
Omarchy installer on your Mac. SSH and GPG keys, saved logins and tokens, and
browser data stay behind.

Choose a transfer passphrase of at least $minimum characters. You'll need it to
import on the native install, and it can't be recovered.

EOF

secret=''
for _ in 1 2 3; do
  IFS= read -r -s -p 'Transfer passphrase: ' secret
  echo
  if ((${#secret} < minimum)); then
    echo "Use at least $minimum characters."
    continue
  fi
  IFS= read -r -s -p 'Repeat passphrase: ' again
  echo
  if [[ $secret != "$again" ]]; then
    echo "The passphrases don't match."
    secret=''
    continue
  fi
  break
done
unset again
((${#secret} >= minimum)) || exit 1

shut_down() {
  if [[ -n ${TRY_OMARCHY_SHUTDOWN:-} ]]; then
    $TRY_OMARCHY_SHUTDOWN
  elif command -v omarchy-system >/dev/null; then
    omarchy-system shutdown
  else
    systemctl poweroff
  fi
}

confirm() {
  local answer
  if [[ -n $gum ]]; then
    "$gum" confirm --affirmative Yes --negative No "$1"
    return
  fi
  printf '%s [Y/n] ' "$1"
  IFS= read -r answer || return 1
  [[ -z $answer || $answer == [Yy] || $answer == [Yy][Ee][Ss] ]]
}

echo
status=0
printf '%s\n' "$secret" | $sudo "$helper" || status=$?
unset secret
((status == 0)) || exit "$status"

# Shutting down is what saves the export on the Mac.
if [[ $interactive == 1 ]]; then
  echo
  if confirm "Shut down Omarchy now?"; then
    shut_down
  fi
fi
