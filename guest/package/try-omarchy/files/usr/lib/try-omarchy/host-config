#!/bin/bash
#
# Publish the Try Omarchy launcher's settings for this boot. The Mac app passes
# them as the systemd credential tryomarchy.host (SMBIOS type 11): one line of
# space-separated tokens, the same vocabulary the kernel command line carried
# before the guest owned its boot (tryomarchy.keyboard=jis,
# omarchy.shared_folder_name=Work, ...). Readers use /run/try-omarchy/cmdline.
#
# Without the credential (another hypervisor, or a manual boot) nothing is
# written, and every unit conditioned on the file stays inactive.

set -euo pipefail

credential=${CREDENTIALS_DIRECTORY:-}/tryomarchy.host
output=${TRY_OMARCHY_HOST_CONFIG_OUTPUT:-/run/try-omarchy/cmdline}

[[ -n ${CREDENTIALS_DIRECTORY:-} && -f $credential ]] || exit 0

# One printable line, bounded, no control characters.
size=$(wc -c <"$credential" | tr -d " ")
((size <= 16384)) || { echo "try-omarchy-host-config: oversized host settings" >&2; exit 1; }
value=$(tr -d '\n' <"$credential")
if [[ $value == *[![:print:]]* ]]; then
  echo "try-omarchy-host-config: host settings contain control characters" >&2
  exit 1
fi

install -d -m 0755 "${output%/*}"
printf '%s\n' "$value" >"$output.tmp"
chmod 0644 "$output.tmp"
mv -f "$output.tmp" "$output"

# The Mac's displays, for omarchy-native-display-sync. With one virtio-gpu
# head per display, tryomarchy.display_layout=OUTPUT:XxY,... names each
# guest output and where Omarchy should place it, in Hyprland's logical
# pixels, arranged as the Mac's own display settings are, the Mac's main
# display first. One line per output; without the token (one display, an
# older app) nothing is written and the helper leaves placement to Hyprland.
layout=${TRY_OMARCHY_DISPLAY_LAYOUT_OUTPUT:-/run/try-omarchy/display-layout}
placement='Virtual-[1-9][0-9]?:[0-9]{1,5}x[0-9]{1,5}'
outputs=()
for token in $value; do
  [[ $token == tryomarchy.display_layout=* ]] || continue
  placements=${token#*=}
  outputs=()
  if [[ ! $placements =~ ^$placement(,$placement){0,7}$ ]]; then
    echo "try-omarchy-host-config: ignoring malformed display layout" >&2
    continue
  fi
  IFS=, read -ra placements <<<"$placements"
  for entry in "${placements[@]}"; do
    outputs+=("${entry%%:*} ${entry#*:}")
  done
done
if ((${#outputs[@]})); then
  install -d -m 0755 "${layout%/*}"
  printf '%s\n' "${outputs[@]}" >"$layout.tmp"
  chmod 0644 "$layout.tmp"
  mv -f "$layout.tmp" "$layout"
else
  rm -f "$layout"
fi

# The Mac's camera housing, for Omarchy's bar. Omarchy reads a platform's
# cutouts from /usr/share/omarchy-platform/display-cutouts.json, which this
# package links here. tryomarchy.display_cutouts=WIDTHxHEIGHT:TOP,... names
# the built-in panel's modes in pixels; that panel's output has one of them
# exactly when the Mac's full screen covers the strip beside the housing, so
# a window or an external display keeps Omarchy's usual bar. With more
# displays, tryomarchy.display_panel=OUTPUT names the panel's output; alone,
# the panel is the only output.
cutouts=${TRY_OMARCHY_DISPLAY_CUTOUTS_OUTPUT:-/run/try-omarchy/display-cutouts.json}
entry='[1-9][0-9]{0,4}x[1-9][0-9]{0,4}:[1-9][0-9]{0,3}'
panel_output=Virtual-1
for token in $value; do
  [[ $token == tryomarchy.display_panel=* ]] || continue
  if [[ ${token#*=} =~ ^Virtual-[1-9][0-9]?$ ]]; then
    panel_output=${token#*=}
  else
    echo "try-omarchy-host-config: ignoring malformed display panel" >&2
  fi
done
panels=()
for token in $value; do
  [[ $token == tryomarchy.display_cutouts=* ]] || continue
  modes=${token#*=}
  panels=()
  if [[ ! $modes =~ ^$entry(,$entry){0,63}$ ]]; then
    echo "try-omarchy-host-config: ignoring malformed display cutouts" >&2
    continue
  fi
  IFS=, read -ra modes <<<"$modes"
  for mode in "${modes[@]}"; do
    size=${mode%:*} top=${mode#*:}
    panels+=("{\"connector\": \"$panel_output\", \"width\": ${size%x*}, \"height\": ${size#*x}, \"top\": $top}")
  done
done
if ((${#panels[@]})); then
  install -d -m 0755 "${cutouts%/*}"
  {
    printf '{ "panels": [\n'
    for i in "${!panels[@]}"; do
      printf '  %s%s\n' "${panels[$i]}" "$( ((i + 1 < ${#panels[@]})) && echo ,)"
    done
    printf '] }\n'
  } >"$cutouts.tmp"
  chmod 0644 "$cutouts.tmp"
  mv -f "$cutouts.tmp" "$cutouts"
else
  rm -f "$cutouts"
fi
