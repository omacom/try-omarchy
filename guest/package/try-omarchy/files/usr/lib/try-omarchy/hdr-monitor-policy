#!/usr/bin/python3
import pathlib
import re
import sys

sdr = 'bitdepth = 8, cm = "srgb"'
data = pathlib.Path(sys.argv[1]).read_bytes()
if len(data) < 128 or data[:8] != b"\x00\xff\xff\xff\xff\xff\xff\x00" or sum(data[:128]) % 256:
    print(sdr)
    raise SystemExit(0)
pq = False
descriptors = [data[offset:offset + 18] for offset in range(54, 126, 18)]
for index in range(min(data[126], len(data) // 128 - 1)):
    block = data[(index + 1) * 128:(index + 2) * 128]
    if block[0] != 2 or sum(block) % 256 or not 4 <= block[2] <= 127:
        continue
    descriptors.extend(block[offset:offset + 18] for offset in range(block[2], 110, 18))
    offset = 4
    while offset < block[2]:
        tag, length = block[offset] >> 5, block[offset] & 31
        payload = block[offset + 1:offset + 1 + length]
        if offset + 1 + length > block[2]:
            break
        if tag == 7 and length >= 3 and payload[0] == 6 and payload[1] & 4:
            pq = True
        offset += length + 1
white = 203
for descriptor in descriptors:
    if descriptor[:5] != b"\x00\x00\x00\xfe\x00":
        continue
    match = re.fullmatch(rb"TO-SDR:([0-9]{1,4})[ \n\x00]*", descriptor[5:])
    if match and 1 <= int(match[1]) <= 1000:
        white = int(match[1])
print(f'bitdepth = 10, cm = "hdredid", sdr_max_luminance = {white}' if pq else sdr)
