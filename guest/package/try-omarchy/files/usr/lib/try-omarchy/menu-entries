#!/usr/bin/python3 -I
"""Add Try Omarchy's rows to the user's Omarchy menu extension, once each.

Omarchy reads menu extensions only from ~/.config/omarchy/extensions/
omarchy-menu.jsonc. The rows go in right after the opening brace. Omarchy's
parser drops whole-line comments and trailing commas. A marker in
~/.local/state/try-omarchy records the newest release of rows added, so rows
the user deletes stay deleted and a later release adds only its new rows.
"""

import os
from pathlib import Path
import sys
import tempfile

# (key, row, release that added it).
ROWS = (
    ("setup.try-omarchy",
     '  "setup.try-omarchy": {"icon":"","iconFont":"omarchy","label":"Try Omarchy Settings",'
     '"description":"Open the Mac app settings","action":"omarchy-native-settings",'
     '"when":"test -w /dev/virtio-ports/dev.tryomarchy.settings"},\n', 1),
    ("setup.security.touch-id",
     '  "setup.security.touch-id": {"icon":"\U000f0237","label":"Touch ID for sudo",'
     '"when":"[[ -x /usr/bin/try-omarchy-touch-id ]]",'
     '"checked":"/usr/bin/try-omarchy-touch-id status --quiet",'
     '"action":"omarchy-launch-floating-terminal-with-presentation /usr/bin/try-omarchy-touch-id"},\n', 1),
    ("setup.security.onepassword-touch-id",
     '  "setup.security.onepassword-touch-id": {"icon":"\U000f0881","label":"Touch ID for 1Password",'
     '"when":"[[ -x /opt/1Password/1password && -x /usr/bin/try-omarchy-onepassword-touch-id ]]",'
     '"checked":"/usr/bin/try-omarchy-onepassword-touch-id status --quiet",'
     '"action":"omarchy-launch-floating-terminal-with-presentation /usr/bin/try-omarchy-onepassword-touch-id"},\n', 2),
    # Overrides only the action of Omarchy's own Timezone row, adding Same as macOS.
    ("update.timezone",
     '  "update.timezone": {"action":"if [[ -x /usr/bin/try-omarchy-timezone-menu ]]; then '
     'exec /usr/bin/try-omarchy-timezone-menu; else exec omarchy-menu-timezone; fi"},\n', 3),
    # Hidden in the VM, keeping Omarchy's own condition: a direct UEFI entry
    # would skip Limine and its snapshots, and there is no firmware to update.
    ("setup.direct-boot",
     '  "setup.direct-boot": {"when":"! omarchy-hw-vm && ! omarchy-hw-aarch64-apple && '
     '[[ ! -f /etc/limine-entry-tool.d/zz-omarchy-dgx-spark.conf ]]"},\n', 4),
    ("update.firmware", '  "update.firmware": {"when":"! omarchy-hw-vm"},\n', 4),
    # The Mac's battery shows in the bar, but the VM has no lid or laptop
    # chassis, so Omarchy's own condition hides the percentage toggle.
    ("trigger.appearance.top-bar.indicators.battery-percentage",
     '  "trigger.appearance.top-bar.indicators.battery-percentage": '
     '{"when":"omarchy-hw-laptop || compgen -G \'/sys/class/power_supply/BAT*\' >/dev/null"},\n', 5),
    # The VM has no Wi-Fi or Bluetooth hardware to restart.
    ("update.hardware.wifi", '  "update.hardware.wifi": {"when":"! omarchy-hw-vm"},\n', 5),
    ("update.hardware.bluetooth", '  "update.hardware.bluetooth": {"when":"! omarchy-hw-vm"},\n', 5),
    # These install Windows games through Wine (Lutris, Battle.net) or an
    # x86_64 client (GeForce NOW), which aarch64 has no packages for. Omarchy
    # already hides Minecraft and Heroic this way.
    ("install.gaming.geforce-now", '  "install.gaming.geforce-now": {"when":"omarchy-hw-x86"},\n', 5),
    ("install.gaming.battlenet", '  "install.gaming.battlenet": {"when":"omarchy-hw-x86"},\n', 5),
    ("install.gaming.lutris", '  "install.gaming.lutris": {"when":"omarchy-hw-x86"},\n', 5),
)
RELEASE = max(release for _, _, release in ROWS)
HEADER = "  // Try Omarchy: Mac integration rows and VM adjustments (added once each; safe to remove).\n"
MAXIMUM_BYTES = 256 * 1024


def added_release(state):
    marker = state / "try-omarchy/menu-entries"
    if marker.is_file():
        try:
            return int(marker.read_text().strip())
        except ValueError:
            return RELEASE
    # The first release recorded its rows with this marker.
    return 1 if (state / "try-omarchy/menu-entries-v1").exists() else 0


def main():
    home = Path(os.environ["HOME"])
    config = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
    state = Path(os.environ.get("XDG_STATE_HOME") or home / ".local/state")
    path = config / "omarchy/extensions/omarchy-menu.jsonc"
    done = added_release(state)
    if done >= RELEASE or path.is_symlink():
        return 0

    if path.exists():
        if path.stat().st_size > MAXIMUM_BYTES:
            return 0
        text = path.read_text()
        opening = text.find("{")
        if opening < 0 or text[:opening].strip() or text.rstrip()[-1:] != "}":
            return 0  # not a plain JSONC object; leave the user's file alone
    else:
        text = "{\n}\n"
        opening = 0

    rows = "".join(row for key, row, release in ROWS if release > done and f'"{key}"' not in text)
    if rows:
        if "// Try Omarchy:" not in text:
            rows = HEADER + rows
        text = text[: opening + 1] + "\n" + rows + text[opening + 1:].lstrip("\n")
        path.parent.mkdir(parents=True, exist_ok=True)
        descriptor, temporary = tempfile.mkstemp(prefix=".omarchy-menu.", dir=path.parent)
        with os.fdopen(descriptor, "w") as output:
            output.write(text)
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    marker = state / "try-omarchy/menu-entries"
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.write_text(f"{RELEASE}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
