#!/usr/bin/python3 -I
"""Keep Try Omarchy's rows in the user's Omarchy menu extension.

Omarchy reads menu extensions only from ~/.config/omarchy/extensions/
omarchy-menu.jsonc; new rows go in right after the opening brace. Omarchy's
parser drops whole-line comments and trailing commas.

Some rows are Try Omarchy's own; the others change one of Omarchy's rows (its
action, or the condition that shows it). Omarchy's merge replaces a row whole,
filling every field the extension leaves out with a default, so a changed row
carries Omarchy's complete row, read from the installed Omarchy at every
login, with only our change applied. A row whose text is still exactly what
this wrote last time is rewritten when Omarchy's row changes; a row the user
edited is left as it is.

A marker in ~/.local/state/try-omarchy records the newest release of rows
added, so rows the user deletes stay deleted and a later release adds only its
new rows. menu-rows.json beside it records the text written for each row.
"""

import json
import os
from pathlib import Path
import re
import sys
import tempfile

MAXIMUM_BYTES = 256 * 1024
HEADER = "  // Try Omarchy: Mac integration rows and VM adjustments (added once each; safe to remove).\n"
TIMEZONE_ACTION = ("if [[ -x /usr/bin/try-omarchy-timezone-menu ]]; then exec /usr/bin/try-omarchy-timezone-menu; "
                   "else exec omarchy-menu-timezone; fi")
BATTERY_PRESENT = "compgen -G '/sys/class/power_supply/BAT*' >/dev/null"


def own(entry):
    return lambda omarchy: entry


def changed(key, change):
    def build(omarchy):
        base = omarchy.get(key)
        if not isinstance(base, dict):
            return None  # Omarchy no longer has the row; nothing to change
        entry = dict(base)
        change(entry)
        return entry
    return build


def set_action(action):
    def change(entry):
        entry["action"] = action
    return change


def hide_unless(condition):
    """Show the row only when condition holds, and Omarchy's own condition too."""
    def change(entry):
        current = entry.get("when", "")
        entry["when"] = f"{condition} && ({current})" if current else condition
    return change


def also_show_when(condition):
    def change(entry):
        current = entry.get("when", "")
        entry["when"] = f"({current}) || {condition}" if current else condition
    return change


# (key, release that added it, builder from Omarchy's rows to our entry).
ROWS = (
    ("setup.try-omarchy", 1, own({
        "icon": "", "iconFont": "omarchy", "label": "Try Omarchy Settings",
        "description": "Open the Mac app settings", "action": "omarchy-native-settings",
        "when": "test -w /dev/virtio-ports/dev.tryomarchy.settings"})),
    ("setup.security.touch-id", 1, own({
        "icon": "\U000f0237", "label": "Touch ID for sudo",
        "when": "[[ -x /usr/bin/try-omarchy-touch-id ]]",
        "checked": "/usr/bin/try-omarchy-touch-id status --quiet",
        "action": "omarchy-launch-floating-terminal-with-presentation /usr/bin/try-omarchy-touch-id"})),
    ("setup.security.onepassword-touch-id", 2, own({
        "icon": "\U000f0881", "label": "Touch ID for 1Password",
        "when": "[[ -x /opt/1Password/1password && -x /usr/bin/try-omarchy-onepassword-touch-id ]]",
        "checked": "/usr/bin/try-omarchy-onepassword-touch-id status --quiet",
        "action": "omarchy-launch-floating-terminal-with-presentation /usr/bin/try-omarchy-onepassword-touch-id"})),
    # Shown while the app attaches a VM from an earlier direct-boot version.
    ("setup.import-previous-vm", 7, own({
        "icon": "\U000f01da", "label": "Import Previous VM",
        "description": "Copy files from the VM of an earlier Try Omarchy",
        "when": "test -b /dev/disk/by-id/virtio-omarchy-previous",
        "action": "omarchy-launch-floating-terminal-with-presentation /usr/bin/try-omarchy-import-previous"})),
    # Omarchy's Timezone row opens the picker with Same as macOS first.
    ("update.timezone", 3, changed("update.timezone", set_action(TIMEZONE_ACTION))),
    # A direct UEFI entry would skip Limine and its snapshots; a VM has no
    # firmware to update, and no Wi-Fi or Bluetooth hardware to restart.
    ("setup.direct-boot", 4, changed("setup.direct-boot", hide_unless("! omarchy-hw-vm"))),
    ("update.firmware", 4, changed("update.firmware", hide_unless("! omarchy-hw-vm"))),
    ("update.hardware.wifi", 5, changed("update.hardware.wifi", hide_unless("! omarchy-hw-vm"))),
    ("update.hardware.bluetooth", 5, changed("update.hardware.bluetooth", hide_unless("! omarchy-hw-vm"))),
    # The Mac's battery shows in the bar, but the VM has no lid or laptop
    # chassis, so Omarchy's own condition hides the percentage toggle.
    ("trigger.appearance.top-bar.indicators.battery-percentage", 5,
     changed("trigger.appearance.top-bar.indicators.battery-percentage", also_show_when(BATTERY_PRESENT))),
    # These install Windows games through Wine (Lutris, Battle.net) or an
    # x86_64 client (GeForce NOW), which aarch64 has no packages for. Omarchy
    # hides Minecraft and Heroic the same way.
    ("install.gaming.geforce-now", 5, changed("install.gaming.geforce-now", hide_unless("omarchy-hw-x86"))),
    ("install.gaming.battlenet", 5, changed("install.gaming.battlenet", hide_unless("omarchy-hw-x86"))),
    ("install.gaming.lutris", 5, changed("install.gaming.lutris", hide_unless("omarchy-hw-x86"))),
)
RELEASE = 7

# Rows earlier packages wrote with only the changed field, which Omarchy's
# merge turned into rows without a label or an action. Still exactly as
# written, they are ours to replace.
LEGACY = {
    "update.timezone": '  "update.timezone": {"action":"' + TIMEZONE_ACTION + '"},\n',
    "setup.direct-boot": '  "setup.direct-boot": {"when":"! omarchy-hw-vm && ! omarchy-hw-aarch64-apple && '
                         '[[ ! -f /etc/limine-entry-tool.d/zz-omarchy-dgx-spark.conf ]]"},\n',
    "update.firmware": '  "update.firmware": {"when":"! omarchy-hw-vm"},\n',
    "trigger.appearance.top-bar.indicators.battery-percentage":
        '  "trigger.appearance.top-bar.indicators.battery-percentage": '
        '{"when":"omarchy-hw-laptop || ' + BATTERY_PRESENT + '"},\n',
    "update.hardware.wifi": '  "update.hardware.wifi": {"when":"! omarchy-hw-vm"},\n',
    "update.hardware.bluetooth": '  "update.hardware.bluetooth": {"when":"! omarchy-hw-vm"},\n',
    "install.gaming.geforce-now": '  "install.gaming.geforce-now": {"when":"omarchy-hw-x86"},\n',
    "install.gaming.battlenet": '  "install.gaming.battlenet": {"when":"omarchy-hw-x86"},\n',
    "install.gaming.lutris": '  "install.gaming.lutris": {"when":"omarchy-hw-x86"},\n',
}


def parse_jsonc(text):
    # Omarchy's stripJsonc: whole-line comments and trailing commas.
    text = re.sub(r"^\s*//[^\n]*(\n|$)", "", text, flags=re.M)
    return json.loads(re.sub(r",(\s*[}\]])", r"\1", text))


def omarchy_rows():
    path = Path(os.environ.get("TRY_OMARCHY_OMARCHY_MENU")
                or Path(os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy") / "default/omarchy/omarchy-menu.jsonc")
    try:
        rows = parse_jsonc(path.read_text())
    except (OSError, ValueError):
        return {}
    return rows if isinstance(rows, dict) else {}


def render(key, entry):
    return f'  "{key}": {json.dumps(entry, ensure_ascii=False, separators=(",", ":"))},\n'


def added_release(state):
    marker = state / "try-omarchy/menu-entries"
    if marker.is_file():
        try:
            return int(marker.read_text().strip())
        except ValueError:
            return RELEASE
    # The first release recorded its rows with this marker.
    return 1 if (state / "try-omarchy/menu-entries-v1").exists() else 0


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    with os.fdopen(descriptor, "w") as output:
        output.write(text)
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def main():
    home = Path(os.environ["HOME"])
    config = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
    state = Path(os.environ.get("XDG_STATE_HOME") or home / ".local/state")
    path = config / "omarchy/extensions/omarchy-menu.jsonc"
    written_path = state / "try-omarchy/menu-rows.json"
    if path.is_symlink():
        return 0

    if path.exists():
        if path.stat().st_size > MAXIMUM_BYTES:
            return 0
        text = path.read_text()
        opening = text.find("{")
        if opening < 0 or text[:opening].strip() or text.rstrip()[-1:] != "}":
            return 0  # not a plain JSONC object; leave the user's file alone
    else:
        text = "{\n}\n"
        opening = 0
    original = text
    try:
        written = json.loads(written_path.read_text())
        if not isinstance(written, dict):
            written = {}
    except (OSError, ValueError):
        written = {}

    done = added_release(state)
    omarchy = omarchy_rows()
    new_rows = ""
    for key, release, build in ROWS:
        entry = build(omarchy)
        row = render(key, entry) if entry else None
        line = re.search(rf'^  "{re.escape(key)}":[^\n]*\n', text, re.M)
        if line or f'"{key}"' in text:
            current = line.group(0) if line else None
            if row and current and current != row and current in (written.get(key), LEGACY.get(key)):
                text = text.replace(current, row, 1)
                written[key] = row
            elif row and current == row:
                written[key] = row
            continue
        if release > done and row:
            new_rows += row
            written[key] = row

    if new_rows:
        if "// Try Omarchy:" not in text:
            new_rows = HEADER + new_rows
        opening = text.find("{")
        text = text[: opening + 1] + "\n" + new_rows + text[opening + 1:].lstrip("\n")
    if text != original:
        write(path, text)
    write(written_path, json.dumps(written, ensure_ascii=False, indent=1) + "\n")
    marker = state / "try-omarchy/menu-entries"
    marker.write_text(f"{RELEASE}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
