[Unit]
Description=Expose macOS audio devices to Omarchy
PartOf=graphical-session.target
After=graphical-session.target pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service pipewire-pulse.service wireplumber.service
# The port is granted to the active session by logind (uaccess), which can
# land after the user manager starts this unit: keep retrying.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/omarchy-native-audio-bridge
Restart=on-failure
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30

[Install]
WantedBy=graphical-session.target
