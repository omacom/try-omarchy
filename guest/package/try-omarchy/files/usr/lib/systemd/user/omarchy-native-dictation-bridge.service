[Unit]
Description=Recognise Omarchy dictation with Apple speech on the Mac
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=/dev/virtio-ports/dev.tryomarchy.dictation
# The agent exits non-zero whenever the host bridge disconnects; keep
# retrying for as long as the launcher keeps restarting that bridge.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/omarchy-native-dictation-bridge
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
