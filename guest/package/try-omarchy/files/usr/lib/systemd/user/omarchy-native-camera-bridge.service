[Unit]
Description=Expose the macOS camera to Omarchy over virtio
# The camera devices are granted to the active session by logind (uaccess),
# which can land after the user manager starts this unit: keep retrying.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/omarchy-native-camera-bridge
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
