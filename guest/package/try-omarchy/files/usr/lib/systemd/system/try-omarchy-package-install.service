[Unit]
Description=Install the Try Omarchy package offered by the Mac app
# pacman takes one transaction at a time: Omarchy's first-boot hardware setup
# (which also makes the machine's keyring) installs packages too, so wait for it.
After=local-fs.target network-online.target omarchy-provision-hardware.service
Before=display-manager.service omarchy-provision-owner.service getty@tty1.service

[Service]
Type=oneshot
RemainAfterExit=yes
ImportCredential=tryomarchy.package
ExecStart=/usr/lib/try-omarchy/package-install
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
