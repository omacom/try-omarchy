--- a/bin/omarchy-toggle-nightlight
+++ b/bin/omarchy-toggle-nightlight
@@ -2,6 +2,18 @@
 
 # omarchy:summary=Toggle nightlight screen temperature
-# omarchy:args=[--status]
+# omarchy:args=[--status | --temperature 4000|6500]
 # omarchy:examples=omarchy toggle nightlight
+
+# The native guest has no DRM CTM. Keep the command and shell on one backend.
+case " $(cat /proc/cmdline) " in
+  *" omarchy.qemu_virgl=1 "*) exec omarchy-native-nightlight "$@" ;;
+esac
+
+if (( $# > 0 )) && [[ ${1:-} != --status ]]; then
+  if (( $# != 2 )) || [[ $1 != --temperature || ! $2 =~ ^(4000|6500)$ ]]; then
+    echo "Usage: omarchy-toggle-nightlight [--status | --temperature 4000|6500]" >&2
+    exit 2
+  fi
+fi
 
 ON_TEMP=4000
@@ -43,5 +55,7 @@
 CURRENT_TEMP=$(current_temp)
 
-if [[ -z $CURRENT_TEMP || $CURRENT_TEMP == $OFF_TEMP ]]; then
+if [[ ${1:-} == --temperature ]]; then
+  TARGET_TEMP=$2
+elif [[ -z $CURRENT_TEMP || $CURRENT_TEMP == $OFF_TEMP ]]; then
   TARGET_TEMP=$ON_TEMP
 else
