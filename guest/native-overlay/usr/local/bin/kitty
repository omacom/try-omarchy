#!/bin/bash

# Kitty cannot create its OpenGL context on Try Omarchy's VirGL guest.
# Force Mesa software rendering so the terminal can open normally.
# Prefer the pacman binary so this PATH shim never recurses on itself.

real=/usr/bin/kitty
if [[ ! -x $real ]]; then
  echo "kitty is not installed" >&2
  exit 127
fi

cmdline_file=${OMARCHY_KITTY_CMDLINE:-/proc/cmdline}
if [[ -r $cmdline_file ]]; then
  read -r -a kernel_options <"$cmdline_file" || true
  for kernel_option in "${kernel_options[@]}"; do
    if [[ $kernel_option == omarchy.qemu_virgl=1 ]]; then
      export LIBGL_ALWAYS_SOFTWARE=1
      break
    fi
  done
fi

exec "$real" "$@"
