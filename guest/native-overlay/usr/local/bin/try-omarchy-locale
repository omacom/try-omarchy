#!/bin/sh

# Seed LANG from the Mac on a fresh factory's first boot, before login or
# owner provisioning. Once consumed, the factory marker is never recreated;
# subsequent boots preserve language choices made inside Omarchy.

set -eu

cmdline_path=${TRY_OMARCHY_LOCALE_CMDLINE_PATH:-/proc/cmdline}
locale_conf=${TRY_OMARCHY_LOCALE_CONF_PATH:-/etc/locale.conf}
pending=${TRY_OMARCHY_LOCALE_PENDING_PATH:-/var/lib/try-omarchy/locale-pending}
[ -f "$pending" ] || exit 0
[ ! -L "$pending" ] || exit 1

# Refuse to write through a symlink (dangling or not). This runs as root on
# every boot, and locale_conf's target would otherwise be unchecked.
[ ! -L "$locale_conf" ] || exit 1

command_line=""
IFS= read -r command_line <"$cmdline_path" || exit 1

# Unsupported or absent host language uses the factory default.
locale=en_US.UTF-8
set -f
for argument in $command_line; do
  case $argument in
    tryomarchy.locale=*)
      candidate=${argument#tryomarchy.locale=}
      # Allowlist: only locales configure-rootfs.sh actually generates into
      # /etc/locale.gen. The kernel command line is attacker-influenced in
      # principle and this value is about to be written into a file PAM
      # reads on every login, so anything else is ignored (keeping whatever
      # is already selected) rather than trusted or shell-interpolated.
      case $candidate in
        en_US.UTF-8 | zh_TW.UTF-8 | zh_CN.UTF-8 | ko_KR.UTF-8) locale=$candidate ;;
      esac
      ;;
  esac
done

# Check the Korean input profile before writing anything, so a refused
# profile leaves both files untouched for the next boot's retry.
fcitx5_profile=${TRY_OMARCHY_LOCALE_FCITX5_PROFILE_PATH:-/etc/skel/.config/fcitx5/profile}
if [ "$locale" = ko_KR.UTF-8 ]; then
  if [ -L "$fcitx5_profile" ]; then
    exit 1
  fi
  if [ -e "$fcitx5_profile" ] && [ ! -f "$fcitx5_profile" ]; then
    echo "fcitx5 profile must be a regular file" >&2
    exit 1
  fi
fi

# Replace LANG only: users can customize LC_TIME, LC_NUMERIC and other
# categories after provisioning. Never source their configuration as root.
python3 - "$locale_conf" "$locale" <<'PY'
import os
from pathlib import Path
import re
import stat
import sys
import tempfile

path = Path(sys.argv[1])
try:
    mode = path.lstat().st_mode
except FileNotFoundError:
    mode = stat.S_IFREG | 0o644
if not stat.S_ISREG(mode):
    raise SystemExit("locale.conf must be a regular file")
contents = path.read_text() if path.exists() else ""
lines = [line for line in contents.splitlines(keepends=True)
         if not re.match(r"^[ \t]*(?:export[ \t]+)?LANG[ \t]*=", line)]
preserved = "".join(lines)
if preserved and not preserved.endswith("\n"):
    preserved += "\n"
updated = preserved + f"LANG={sys.argv[2]}\n"
if contents != updated:
    descriptor, temporary = tempfile.mkstemp(prefix=".locale.conf.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w") as output:
            output.write(updated)
            output.flush()
            os.fchmod(output.fileno(), stat.S_IMODE(mode))
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
PY

# The owner account is created from /etc/skel after this unit, which orders
# Before=omarchy-provision-owner.service. Select Korean only for a Korean Mac;
# leave other locales and customized group orders untouched.
if [ "$locale" = ko_KR.UTF-8 ]; then
  python3 - "$fcitx5_profile" <<'PY'
import os
from pathlib import Path
import re
import stat
import sys
import tempfile

path = Path(sys.argv[1])
try:
    mode = path.lstat().st_mode
except FileNotFoundError:
    # A removed profile should not prevent LANG initialization or be recreated.
    raise SystemExit(0)
if not stat.S_ISREG(mode):
    raise SystemExit("fcitx5 profile must be a regular file")
contents = path.read_bytes()
orders = list(re.finditer(
    rb"^\[GroupOrder\]\n(.*?)(?=^\[|\Z)", contents, re.MULTILINE | re.DOTALL
))
if len(orders) != 1 or orders[0].group(1) != b"0=Default\n1=Korean\n":
    raise SystemExit(0)
start, end = orders[0].span(1)
updated = contents[:start] + b"0=Korean\n1=Default\n" + contents[end:]
descriptor, temporary = tempfile.mkstemp(prefix=".fcitx5-profile.", dir=path.parent)
try:
    with os.fdopen(descriptor, "wb") as output:
        output.write(updated)
        output.flush()
        os.fchmod(output.fileno(), stat.S_IMODE(mode))
        os.fsync(output.fileno())
    os.replace(temporary, path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
PY
fi

# Keep the marker on failure so the next boot can retry.
rm -- "$pending"
