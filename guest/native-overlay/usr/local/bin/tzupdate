#!/usr/bin/python3 -I
"""Give Omarchy's setup the Mac zone while this guest follows the Mac."""
import json
import os
from pathlib import Path
import sys

if sys.argv[1:] == ["-p"]:
    try:
        state = json.loads(Path("/var/lib/try-omarchy/timezone.json").read_text())
        if state["mode"] == "auto":
            print(state["zone"])
            sys.exit(0)
    except (OSError, ValueError, KeyError):
        pass
os.execv("/usr/bin/tzupdate", ["tzupdate", *sys.argv[1:]])
