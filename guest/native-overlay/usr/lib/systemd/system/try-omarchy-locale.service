[Unit]
Description=Initialize the guest language from the Mac once
# Provisioning can start a login itself, so seed before it as well as SDDM/getty.
ConditionPathExists=/var/lib/try-omarchy/locale-pending
After=local-fs.target
Before=sddm.service display-manager.service getty@tty1.service omarchy-provision-owner.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/try-omarchy-locale

[Install]
WantedBy=multi-user.target
