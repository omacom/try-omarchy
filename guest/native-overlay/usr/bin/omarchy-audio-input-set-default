#!/bin/bash

# Keep Omarchy's default-source behavior, but move only real application
# recordings. module-remap-source owns an internal source output that must stay
# attached to the QEMU HDA source; moving it onto its own virtual source creates
# a cycle and turns an otherwise-live Mac microphone into silence.

node_id=${1:-}
source_name=${2:-}

if [[ -z $node_id || -z $source_name ]]; then
  echo "Usage: omarchy-audio-input-set-default <node-id> <source-name>" >&2
  exit 1
fi

timeout 2 wpctl set-default "$node_id" 2>/dev/null || true
timeout 2 pactl set-default-source "$source_name" 2>/dev/null || true

# The parser below matches pactl's English source-output headers.
LC_ALL=C timeout 2 pactl list source-outputs 2>/dev/null | awk '
  /^Source Output #/ {id = substr($3, 2)}
  /application\.name = / {
    app = $0
    sub(/.*application\.name = "/, "", app)
    sub(/"$/, "", app)
    if (app != "EasyEffects") print id
  }' | while read -r output; do
  [[ -n $output ]] && timeout 2 pactl move-source-output "$output" "$source_name" 2>/dev/null || true
done
