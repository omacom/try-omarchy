 static const struct drm_connector_helper_funcs virtio_gpu_conn_helper_funcs = {
+	.atomic_check = virtio_gpu_conn_atomic_check,
 	.get_modes    = virtio_gpu_conn_get_modes,
 	.mode_valid   = virtio_gpu_conn_mode_valid,
 };
