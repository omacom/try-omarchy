+void virtio_gpu_cmd_omarchy_hdr(struct virtio_gpu_device *vgdev,
+                              const struct virtio_gpu_omarchy_hdr *metadata)
+{
+ struct virtio_gpu_vbuffer *vbuf;
+ struct virtio_gpu_omarchy_hdr *cmd = virtio_gpu_alloc_cmd(vgdev, &vbuf, sizeof(*cmd));
+ *cmd = *metadata;
+ cmd->hdr.type = cpu_to_le32(VIRTIO_GPU_CMD_OMARCHY_HDR);
+ virtio_gpu_queue_ctrl_buffer(vgdev, vbuf);
+}
