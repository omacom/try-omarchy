+#ifndef OMARCHY_VIRTIO_HDR_H
+#define OMARCHY_VIRTIO_HDR_H
+/* Private, opt-in Try Omarchy ABI v1. Not a standard virtio feature. */
+#define VIRTIO_GPU_F_OMARCHY_HDR 6
