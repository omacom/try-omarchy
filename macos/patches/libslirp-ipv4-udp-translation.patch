+/* Keep translated destinations separate without changing ordinary UDP mappings. */
+static bool udp_virtual_destination(Slirp *slirp, struct in_addr addr)
+{
+    return (addr.s_addr & slirp->vnetwork_mask.s_addr) ==
+               slirp->vnetwork_addr.s_addr || addr.s_addr == 0xffffffff;
+}
+
+static struct socket *udp_lookup4(Slirp *slirp,
+                                  const struct sockaddr_storage *local,
+                                  const struct sockaddr_storage *remote)
+{
+    const struct sockaddr_in *peer = (const struct sockaddr_in *)remote;
+    struct socket *so, *match = NULL;
+    for (so = slirp->udb.so_next; so != &slirp->udb; so = so->so_next) {
+        if (!sockaddr_equal(&so->lhost.ss, local)) {
+            continue;
+        }
+        if (so->so_state & SS_HOSTFWD) {
+            return so;
+        }
+        if (sockaddr_equal(&so->fhost.ss, remote) ||
+            (so->so_ffamily == AF_INET &&
+             !udp_virtual_destination(slirp, so->so_faddr) &&
+             !udp_virtual_destination(slirp, peer->sin_addr))) {
+            match = so;
+            break;
+        }
+    }
+    return match;
+}
