diff --git a/ui/cocoa-gl-hdr.h b/ui/cocoa-gl-hdr.h
--- /dev/null
+++ b/ui/cocoa-gl-hdr.h
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef QEMU_COCOA_GL_HDR_H
+#define QEMU_COCOA_GL_HDR_H
+
+static const char cocoa_hdr_vertex[] =
+    "#version 150\n"
+    "out vec2 uv; uniform int flip;\n"
+    "void main() {\n"
+    "  vec2 positions[3] = vec2[3](vec2(-1,-1), vec2(3,-1), vec2(-1,3));\n"
+    "  vec2 p = positions[gl_VertexID];\n"
+    "  gl_Position = vec4(p,0,1); uv = p * 0.5 + 0.5;\n"
+    "  if (flip == 0) uv.y = 1.0 - uv.y;\n"
+    "}\n";
+
+static const char cocoa_hdr_fragment[] =
+    "#version 150\n"
+    "in vec2 uv; out vec4 color;\n"
+    "uniform sampler2D source; uniform int pq; uniform int bt2020;\n"
+    "uniform float sdr_white;\n"
+    "vec3 srgb_linear(vec3 v) {\n"
+    "  return mix(v / 12.92, pow((v + 0.055) / 1.055, vec3(2.4)),\n"
+    "             greaterThan(v, vec3(0.04045)));\n"
+    "}\n"
+    "void main() {\n"
+    "  vec3 rgb = max(texture(source, uv).rgb, vec3(0));\n"
+    "  if (pq != 0) {\n"
+    "    const float m1=2610.0/16384.0, m2=2523.0/32.0;\n"
+    "    const float c1=3424.0/4096.0, c2=2413.0/128.0, c3=2392.0/128.0;\n"
+    "    vec3 v = pow(min(rgb, vec3(1)), vec3(1.0/m2));\n"
+    "    rgb = pow(max(v-c1, vec3(0))/max(c2-c3*v, vec3(0.000001)),\n"
+    "              vec3(1.0/m1)) * (10000.0/sdr_white);\n"
+    "  } else {\n"
+    "    rgb = srgb_linear(rgb);\n"
+    "    if (bt2020 == 0) {\n"
+    "      const mat3 to2020 = mat3(\n"
+    "        0.627403896,0.069097289,0.016391439,\n"
+    "        0.329283038,0.919540395,0.088013308,\n"
+    "        0.043313066,0.011362316,0.895595253);\n"
+    "      rgb = to2020 * rgb;\n"
+    "    }\n"
+    "  }\n"
+    "  color = vec4(rgb,1);\n"
+    "}\n";
+
+typedef struct CocoaGLHDRShader {
+    GLuint program;
+    GLint source, flip, pq, bt2020, sdr_white;
+} CocoaGLHDRShader;
+
+static GLuint cocoa_hdr_compile(GLenum type, const char *source)
+{
+    GLuint shader = glCreateShader(type);
+    GLint ok;
+    glShaderSource(shader, 1, &source, NULL);
+    glCompileShader(shader);
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (!ok) {
+        char message[2048];
+        glGetShaderInfoLog(shader, sizeof(message), NULL, message);
+        fprintf(stderr, "[cocoa-gl-hdr] shader compile failed: %s\n", message);
+        glDeleteShader(shader);
+        return 0;
+    }
+    return shader;
+}
+
+static bool cocoa_hdr_shader_init(CocoaGLHDRShader *shader)
+{
+    GLuint vertex = cocoa_hdr_compile(GL_VERTEX_SHADER, cocoa_hdr_vertex);
+    GLuint fragment = cocoa_hdr_compile(GL_FRAGMENT_SHADER, cocoa_hdr_fragment);
+    GLint ok = 0;
+    if (vertex && fragment) {
+        shader->program = glCreateProgram();
+        glAttachShader(shader->program, vertex);
+        glAttachShader(shader->program, fragment);
+        glLinkProgram(shader->program);
+        glGetProgramiv(shader->program, GL_LINK_STATUS, &ok);
+        if (!ok) {
+            char message[2048];
+            glGetProgramInfoLog(shader->program, sizeof(message), NULL, message);
+            fprintf(stderr, "[cocoa-gl-hdr] shader link failed: %s\n", message);
+            glDeleteProgram(shader->program);
+            shader->program = 0;
+        }
+    }
+    if (vertex) glDeleteShader(vertex);
+    if (fragment) glDeleteShader(fragment);
+    if (!ok) return false;
+    shader->source = glGetUniformLocation(shader->program, "source");
+    shader->flip = glGetUniformLocation(shader->program, "flip");
+    shader->pq = glGetUniformLocation(shader->program, "pq");
+    shader->bt2020 = glGetUniformLocation(shader->program, "bt2020");
+    shader->sdr_white = glGetUniformLocation(shader->program, "sdr_white");
+    return true;
+}
+
+/* Programs are shared by CGL contexts; vertex-array objects are not. */
+static void cocoa_hdr_shader_draw(const CocoaGLHDRShader *shader, GLuint vao,
+                                  GLuint texture, bool flip, bool pq,
+                                  bool bt2020, float sdr_white)
+{
+    GLint old_program, old_vao, old_active, old_texture;
+    GLboolean blend = glIsEnabled(GL_BLEND);
+    GLboolean srgb = glIsEnabled(GL_FRAMEBUFFER_SRGB);
+    glGetIntegerv(GL_CURRENT_PROGRAM, &old_program);
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &old_vao);
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &old_active);
+    glActiveTexture(GL_TEXTURE0);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &old_texture);
+    glDisable(GL_BLEND);
+    glDisable(GL_FRAMEBUFFER_SRGB);
+    glUseProgram(shader->program);
+    glUniform1i(shader->source, 0);
+    glUniform1i(shader->flip, flip);
+    glUniform1i(shader->pq, pq);
+    glUniform1i(shader->bt2020, bt2020);
+    glUniform1f(shader->sdr_white, sdr_white);
+    glBindVertexArray(vao);
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBindTexture(GL_TEXTURE_2D, old_texture);
+    glActiveTexture(old_active);
+    glBindVertexArray(old_vao);
+    glUseProgram(old_program);
+    if (blend) glEnable(GL_BLEND);
+    if (srgb) glEnable(GL_FRAMEBUFFER_SRGB);
+}
+#endif
