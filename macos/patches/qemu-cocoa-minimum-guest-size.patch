From: Try Omarchy contributors
Subject: [PATCH] cocoa: offer the guest at least 800x600 pixels

Applies after the other Try Omarchy Cocoa patches.

The dynamic-display patch makes the guest's preferred mode follow the
window, and virtio-gpu keeps offering that mode after a guest reboot. In a
small window (for example 732x412 at 1x) the firmware's graphics console
then has fewer than 25 rows: QEMU's prebuilt EDK2 is a DEBUG build, so
GraphicsConsoleDxe fails ASSERT (MaxColumns >= 80) && (MaxRows >= 25) and
spins in CpuDeadLoop; the VM never boots again. Clamp the offered size to
800x600 pixels at the window's backing scale, in points, before both the
EDID density and the mode are derived from it, so the density stays the
same and zoom-to-fit scales the larger surface into the window.

--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -821,6 +821,22 @@
 #pragma clang diagnostic push
 #pragma clang diagnostic ignored "-Wdeprecated-declarations"
 
+/*
+ * The guest's preferred mode follows the window and survives a reset into the
+ * firmware. EDK2's graphics console needs 80x25 cells of 8x19 pixels
+ * (640x475) and asserts below that, which hangs QEMU's DEBUG build after a
+ * guest reboot in a small window. Never offer the guest fewer than 800x600
+ * pixels; zoom-to-fit scales a smaller window.
+ */
+static NSSize cocoa_guest_frame_size(NSSize size, CGFloat scale)
+{
+    if (scale <= 0) {
+        scale = 1;
+    }
+    return NSMakeSize(MAX(size.width, ceil(800.0 / scale)),
+                      MAX(size.height, ceil(600.0 / scale)));
+}
+
 - (void) updateUIInfoLocked
 {
     /* Must be called with the BQL, i.e. via updateUIInfo */
@@ -838,7 +854,9 @@
         CVDisplayLinkRef displayLink;
         uint32_t refreshRate = 0;
 
-        frameSize = isFullscreen ? [self screenSafeAreaSize] : [self frame].size;
+        frameSize = cocoa_guest_frame_size(
+            isFullscreen ? [self screenSafeAreaSize] : [self frame].size,
+            [[self window] backingScaleFactor]);
 
         if (!CVDisplayLinkCreateWithCGDisplay(display, &displayLink)) {
             CVTime period = CVDisplayLinkGetNominalOutputVideoRefreshPeriod(displayLink);
@@ -874,7 +892,7 @@
         info.height_mm = 10 * MIN(255, MAX(1, (int)lround(
             frameSize.height * 2.54 / 110.0)));
     } else {
-        frameSize = [self frame].size;
+        frameSize = cocoa_guest_frame_size([self frame].size, 1);
         info.width_mm = 0;
         info.height_mm = 0;
     }
