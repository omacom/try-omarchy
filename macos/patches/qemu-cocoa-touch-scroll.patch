@@ -535,6 +540,25 @@ static void cocoa_pinch_send_frame(void *opaque, const CocoaPinchFrame *frame)
     qemu_input_event_sync();
 }
 
+/* Shares the pinch touchpad's two slots, so only one gesture owns them. */
+static void cocoa_touch_scroll_send_frame(void *opaque,
+                                          const CocoaTouchScrollFrame *frame)
+{
+    for (int slot = 0; slot < 2; slot++) {
+        qemu_input_queue_mtt(dcl.con,
+                            frame->down ? INPUT_MULTI_TOUCH_TYPE_UPDATE :
+                                          INPUT_MULTI_TOUCH_TYPE_END,
+                            slot, frame->down ? slot : -1);
+        if (frame->down) {
+            qemu_input_queue_mtt_abs(dcl.con, INPUT_AXIS_X, frame->x[slot], 0,
+                                    COCOA_TOUCH_SCROLL_AXIS_MAX, slot, slot);
+            qemu_input_queue_mtt_abs(dcl.con, INPUT_AXIS_Y, frame->y, 0,
+                                    COCOA_TOUCH_SCROLL_AXIS_MAX, slot, slot);
+        }
+    }
+    qemu_input_event_sync();
+}
+
 /*
  * The strip AppKit keeps clear of a camera housing at the top of this screen,
  * in points, or 0: external displays, Macs without a notch and the built-in
@@ -1344,6 +1368,45 @@ - (bool) handlePinchLocked:(NSEvent *)event
                             cocoa_pinch_send_frame, NULL);
 }
 
+/* The VM state handler and resume release frame belong to the pinch bridge. */
+- (void) endTouchScrollLocked
+{
+    cocoa_touch_scroll_cancel(&touchScroll, cocoa_touch_scroll_send_frame, NULL);
+}
+
+- (bool) handleTouchScrollLocked:(NSEvent *)event
+{
+    NSEventPhase phase = [event phase];
+    NSPoint point = [self convertPoint:[event locationInWindow] fromView:nil];
+    unsigned action = 0;
+    bool eligible = [event hasPreciseScrollingDeltas] &&
+                    [event momentumPhase] == NSEventPhaseNone &&
+                    [event window] == [self window] &&
+                    [[self window] isKeyWindow] &&
+                    NSPointInRect(point, [self bounds]) &&
+                    qemu_console_is_graphic(dcl.con) &&
+                    runstate_is_running();
+
+    if (!touchScroll.units_per_point) {
+        touchScroll.units_per_point = cocoa_touch_scroll_units_per_point(
+            getenv("TRYOMARCHY_TRACKPAD_SCROLL_SPEED"));
+    }
+    if (phase & NSEventPhaseBegan) {
+        action |= COCOA_TOUCH_SCROLL_BEGIN;
+        [self endPinchLocked];
+    }
+    if (phase & NSEventPhaseEnded) {
+        action |= COCOA_TOUCH_SCROLL_END;
+    }
+    if (phase & NSEventPhaseCancelled) {
+        action |= COCOA_TOUCH_SCROLL_CANCEL;
+    }
+    return cocoa_touch_scroll_event(&touchScroll, action, eligible,
+                                    [event scrollingDeltaX],
+                                    [event scrollingDeltaY],
+                                    cocoa_touch_scroll_send_frame, NULL);
+}
+
 - (bool) handleEvent:(NSEvent *)event
 {
     return bool_with_bql(^{
@@ -1666,6 +1729,7 @@ - (bool) handleEventLocked:(NSEvent *)event
             }
             return true;
         case NSEventTypeMagnify:
+            [self endTouchScrollLocked];
             return [self handlePinchLocked:event];
         case NSEventTypeScrollWheel:
             /*
@@ -1673,6 +1737,11 @@ - (bool) handleEventLocked:(NSEvent *)event
              * This is in-line with standard Mac OS X UI behaviour.
              */
 
+            /* Finger scrolling lets the guest recognize swipe navigation. */
+            if ([self handleTouchScrollLocked:event]) {
+                return true;
+            }
+
             if ([event hasPreciseScrollingDeltas]) {
                 CocoaScrollFrame frame;
 
@@ -1934,6 +2003,7 @@ - (void) raiseAllKeys
 {
     with_bql(^{
         [self endPinchLocked];
+        [self endTouchScrollLocked];
         injectedTextSource = 0;
