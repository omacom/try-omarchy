 #define TYPE_VIRTIO_TABLET     "virtio-tablet-device"
 #define TYPE_VIRTIO_MULTITOUCH "virtio-multitouch-device"
+#define TYPE_VIRTIO_PINCH      "virtio-pinch-device"
 
