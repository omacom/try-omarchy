diff --git a/include/ui/cocoa-scroll.h b/include/ui/cocoa-scroll.h
new file mode 100644
index 0000000..b9b440f
--- /dev/null
+++ b/include/ui/cocoa-scroll.h
@@ -0,0 +1,67 @@
+/*
+ * Cocoa precise-scroll conversion, independent of AppKit for testing.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_COCOA_SCROLL_H
+#define QEMU_COCOA_SCROLL_H
+
+#include <limits.h>
+#include <math.h>
+
+typedef struct CocoaScroll {
+    double residual_x;
+    double residual_y;
+} CocoaScroll;
+
+typedef struct CocoaScrollFrame {
+    int x;
+    int y;
+} CocoaScrollFrame;
+
+/*
+ * AppKit reports precise deltas in points.  Keep one Linux high-resolution
+ * wheel unit per point: this avoids inventing acceleration on top of macOS's
+ * device acceleration, while retaining sub-point deltas between events.
+ */
+static inline int cocoa_scroll_axis(double delta, double *residual)
+{
+    double value;
+    int whole;
+
+    if (!isfinite(delta)) {
+        *residual = 0.0;
+        return 0;
+    }
+
+    value = delta + *residual;
+    if (value >= INT_MAX) {
+        *residual = 0.0;
+        return INT_MAX;
+    }
+    if (value <= INT_MIN) {
+        *residual = 0.0;
+        return INT_MIN;
+    }
+
+    whole = (int)trunc(value);
+    *residual = value - whole;
+    return whole;
+}
+
+static inline CocoaScrollFrame cocoa_scroll_update(CocoaScroll *scroll,
+                                                    double x, double y)
+{
+    CocoaScrollFrame frame = {
+        .x = cocoa_scroll_axis(x, &scroll->residual_x),
+        .y = cocoa_scroll_axis(y, &scroll->residual_y),
+    };
+    return frame;
+}
+
+static inline void cocoa_scroll_cancel(CocoaScroll *scroll)
+{
+    scroll->residual_x = 0.0;
+    scroll->residual_y = 0.0;
+}
+
+#endif
diff --git a/qapi/ui.json b/qapi/ui.json
index e76aa4c..4f0ed20 100644
--- a/qapi/ui.json
+++ b/qapi/ui.json
@@ -1068,12 +1068,19 @@
 ##
 # @InputAxis:
 #
-# Position axis of a pointer input device (mouse, tablet).
+# Position or high-resolution wheel axis of a pointer input device.
+#
+# @wheel: vertical high-resolution wheel movement in Linux v120 units
+#     (Try Omarchy downstream)
+#
+# @hwheel: horizontal high-resolution wheel movement in Linux v120
+#     units
+#     (Try Omarchy downstream)
 #
 # Since: 2.0
 ##
 { 'enum'  : 'InputAxis',
-  'data'  : [ 'x', 'y' ] }
+  'data'  : [ 'x', 'y', 'wheel', 'hwheel' ] }
 
 ##
 # @InputMultiTouchType:
diff --git a/ui/cocoa.m b/ui/cocoa.m
index dbd90e6..59a77d4 100644
--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -38,6 +38,7 @@
 #include "ui/console.h"
 #include "ui/input.h"
 #include "ui/cocoa-pinch.h"
+#include "ui/cocoa-scroll.h"
 #include "ui/kbd-state.h"
 #include "system/system.h"
 #include "system/runstate.h"
@@ -346,6 +347,7 @@ @interface QemuCocoaView : NSView
     int mouseY;
     bool mouseOn;
     CocoaPinch pinch;
+    CocoaScroll scroll;
 }
 - (void) grabMouse;
 - (void) ungrabMouse;
@@ -1183,7 +1185,32 @@ - (bool) handleEventLocked:(NSEvent *)event
              * This is in-line with standard Mac OS X UI behaviour.
              */
 
-            /* Determine if this is a scroll up or scroll down event */
+            if ([event hasPreciseScrollingDeltas]) {
+                CocoaScrollFrame frame;
+
+                if (([event phase] & NSEventPhaseCancelled) ||
+                    ([event momentumPhase] & NSEventPhaseCancelled)) {
+                    cocoa_scroll_cancel(&scroll);
+                    return true;
+                }
+
+                frame = cocoa_scroll_update(&scroll,
+                                            [event scrollingDeltaX],
+                                            [event scrollingDeltaY]);
+                /* Cocoa's positive X means left; Linux REL_HWHEEL is right. */
+                if (frame.x) {
+                    qemu_input_queue_rel(dcl.con, INPUT_AXIS_HWHEEL, -frame.x);
+                }
+                if (frame.y) {
+                    qemu_input_queue_rel(dcl.con, INPUT_AXIS_WHEEL, frame.y);
+                }
+                if (frame.x || frame.y) {
+                    qemu_input_event_sync();
+                }
+                return true;
+            }
+
+            /* Preserve discrete mouse-wheel behavior exactly. */
             if ([event deltaY] != 0) {
                 button = ([event deltaY] > 0) ?
                     INPUT_BUTTON_WHEEL_UP : INPUT_BUTTON_WHEEL_DOWN;
