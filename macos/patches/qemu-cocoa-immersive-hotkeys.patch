+    immersiveMenuItem = [[[NSMenuItem alloc] initWithTitle:@"Immersive Full Screen" action:@selector(toggleImmersive:) keyEquivalent:[NSString stringWithFormat:@"%C", (unichar)0x1b]] autorelease];
+    [immersiveMenuItem setKeyEquivalentModifierMask:NSEventModifierFlagControl | NSEventModifierFlagOption];
+    [immersiveMenuItem setState:immersive_mode_enabled ? NSControlStateValueOn : NSControlStateValueOff];
+    [menu addItem:immersiveMenuItem];
     menuItem = [[[NSMenuItem alloc] initWithTitle:@"Zoom To Fit" action:@selector(zoomToFit:) keyEquivalent:@""] autorelease];
     [menuItem setState: [[cocoaView window] styleMask] & NSWindowStyleMaskResizable ? NSControlStateValueOn : NSControlStateValueOff];
     [menu addItem: menuItem];
@@ -3830,6 +3936,8 @@ static void cocoa_display_init(DisplayState *ds, DisplayOptions *opts)
                         opts->u.cocoa.full_grab;
     immersive_mode_enabled = !opts->u.cocoa.has_immersive ||
                              opts->u.cocoa.immersive;
+    [immersiveMenuItem setState:immersive_mode_enabled ? NSControlStateValueOn
+                                                       : NSControlStateValueOff];
     notch_panel_enabled = !getenv("TRYOMARCHY_NOTCH") ||
                           strcmp(getenv("TRYOMARCHY_NOTCH"), "0") != 0;
     if (!notch_panel_enabled) {
