 {
+    fullscreen_transitioning = true;
     [cocoaView setNotchLeaving:true];
 }
 
@@ -2649,6 +2691,8 @@ - (void)windowDidExitFullScreen:(NSNotification *)notification
     [cocoaView updateScale];
     [cocoaView updateUIInfo];
     [cocoaView ungrabMouse];
+    fullscreen_transitioning = false;
+    immersive_switch_pending = false;
 }
 
 - (void)windowDidResize:(NSNotification *)notification
@@ -2725,6 +2769,11 @@ - (void) doToggleFullScreen:(id)sender
     [[cocoaView window] toggleFullScreen:sender];
 }
 
+- (void) toggleImmersive:(id)sender
+{
+    cocoa_toggle_immersive();
+}
+
 - (void) setFullGrab:(id)sender
 {
     COCOA_DEBUG("QemuCocoaAppController: setFullGrab\n");
@@ -2983,6 +3032,55 @@ - (void)adjustSpeed:(id)sender
 
 @end
 
+static void cocoa_set_immersive(bool enabled)
+{
+    immersive_mode_enabled = enabled;
+    [immersiveMenuItem setState:enabled ? NSControlStateValueOn
+                                        : NSControlStateValueOff];
+}
+
+static void cocoa_fullscreen_transition_failed(void)
+{
+    fullscreen_transitioning = false;
+    if (immersive_switch_pending) {
+        immersive_switch_pending = false;
+        cocoa_set_immersive(immersive_before_switch);
+    }
+}
+
+/*
+ * Control-Option-Escape: the launcher's two choices for this session. The saved
+ * setting is not changed.
+ */
+static void cocoa_toggle_immersive(void)
+{
+    NSWindow *window = [cocoaView window];
+
+    if (fullscreen_transitioning) {
+        return;
+    }
+    immersive_before_switch = immersive_mode_enabled;
+    immersive_switch_pending = true;
+    cocoa_set_immersive(!([window styleMask] & NSWindowStyleMaskFullScreen));
+    info_report("Try Omarchy: immersive mode %s for this session",
+                immersive_mode_enabled ? "on" : "off");
+    [window toggleFullScreen:nil];
+}
+
+/*
+ * Control-Option-Shift-Escape: hand the Mac back without stopping the VM. Hiding
+ * the app leaves its full-screen Space; resigning active releases the
+ * keyboard and every key held in the guest (applicationDidResignActive).
+ * Clicking Try Omarchy in the Dock or Command-Tab brings it back.
+ */
+static void cocoa_return_to_host(void)
+{
+    if (fullscreen_transitioning) {
+        return;
+    }
+    [NSApp hide:nil];
+}
+
 @interface QemuApplication : NSApplication
 @end
 
