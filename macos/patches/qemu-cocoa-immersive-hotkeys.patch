 static bool swap_opt_cmd;
 static bool full_grab_enabled;
 static bool immersive_mode_enabled = true;
+static bool fullscreen_transitioning;
+static bool immersive_switch_pending;
+static bool immersive_before_switch;
+static NSMenuItem *immersiveMenuItem;
+static void cocoa_fullscreen_transition_failed(void);
+static void cocoa_toggle_immersive(void);
+static void cocoa_return_to_host(void);
 static bool notch_panel_enabled = true;
 @class QemuCocoaView;
 extern QemuCocoaView *cocoaView;
@@ -2085,6 +2092,27 @@ - (bool) handleEventLocked:(NSEvent *)event
             // handle control + alt Key Combos (ctrl+alt+[1..9,g] is reserved for QEMU)
             if (([event modifierFlags] & NSEventModifierFlagControl) && ([event modifierFlags] & NSEventModifierFlagOption)) {
                 NSString *keychar = [event charactersIgnoringModifiers];
+
+                /*
+                 * Try Omarchy host shortcuts. They run after this event
+                 * returns, outside the BQL, because AppKit window
+                 * transitions call back into code that takes it. A held
+                 * chord's auto-repeat is consumed without acting again.
+                 */
+                if ([event keyCode] == kVK_Escape) {
+                    bool to_host = [event modifierFlags] & NSEventModifierFlagShift;
+
+                    if (![event isARepeat]) {
+                        dispatch_async(dispatch_get_main_queue(), ^{
+                            if (to_host) {
+                                cocoa_return_to_host();
+                            } else {
+                                cocoa_toggle_immersive();
+                            }
+                        });
+                    }
+                    return true;
+                }
                 if ([keychar length] == 1) {
                     char key = [keychar characterAtIndex:0];
                     switch (key) {
@@ -2624,11 +2652,24 @@ - (void)windowDidChangeBackingProperties:(NSNotification *)notification
 
 - (void)windowWillEnterFullScreen:(NSNotification *)notification
 {
+    fullscreen_transitioning = true;
     [cocoaView setNotchLeaving:false];
 }
 
+- (void)windowDidFailToEnterFullScreen:(NSWindow *)window
+{
+    cocoa_fullscreen_transition_failed();
+}
+
+- (void)windowDidFailToExitFullScreen:(NSWindow *)window
