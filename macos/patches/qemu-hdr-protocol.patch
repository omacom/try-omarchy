+bool qemu_console_gl_has_hdr(QemuConsole *con)
+{
+    DisplayChangeListener *dcl;
+    QLIST_FOREACH(dcl, &con->ds->listeners, next) {
+        if (con == dcl->con && dcl->ops->dpy_gl_has_hdr &&
+            dcl->ops->dpy_gl_has_hdr(dcl)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void qemu_console_gl_hdr_metadata(QemuConsole *con, const QemuHDRMetadata *metadata)
+{
+    DisplayChangeListener *dcl;
+    QLIST_FOREACH(dcl, &con->ds->listeners, next) {
+        if (con == dcl->con && dcl->ops->dpy_gl_hdr_metadata) {
+            dcl->ops->dpy_gl_hdr_metadata(dcl, metadata);
+        }
+    }
+}
