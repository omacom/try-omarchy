     DEFINE_PROP_UINT32("vendorid",  USBHostDevice, match.vendor_id,  0),
@@ -1854,7 +1865,7 @@
             }
             QTAILQ_FOREACH(s, &hostdevs, next) {
                 f = &s->match;
-                if (f->bus_num > 0 &&
