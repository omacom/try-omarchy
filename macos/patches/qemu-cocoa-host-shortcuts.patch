+}
+
+- (BOOL) appSwitcherTapHandlesModifiers
+{
+    return eventsTap && CGEventTapIsEnabled(eventsTap) &&
+           !getenv("TRYOMARCHY_INPUT_OBSERVE_ONLY") && [self isKeyboardCaptured];
 }
 
 /* macOS can disable a slow tap; restore capture after either notification. */
@@ -3765,32 +3950,41 @@
 - (void)sendEvent:(NSEvent *)event
 {
     QemuCocoaView *view = cocoaView;
 
     COCOA_DEBUG("QemuApplication: sendEvent\n");
+    if ([event type] == NSEventTypeFlagsChanged &&
+        cocoa_share_app_switcher_modifier([event keyCode])) {
+        /* Shift toggles in handleEvent, so deliver it only once. */
+        if (![view appSwitcherTapHandlesModifiers]) {
+            [view handleEvent:event];
+        }
+        [super sendEvent:event];
+        return;
+    }
     if (cocoa_caps_lock_key_event(event)) {
         /*
          * AppKit takes part in locking capitals from these events, so they
          * always reach it. QEMU handles them here only when the tap did not.
          */
         if (![cocoaView capsLockTapHandlesKeys]) {
             [cocoaView handleEvent:event];
         }
         [super sendEvent:event];
         return;
     }
     /*
      * Keys go to the first head's view, which keeps the keyboard state for
      * all of them. Gestures and wheels belong to the window under them.
      */
     switch ([event type]) {
     case NSEventTypeMagnify:
     case NSEventTypeScrollWheel:
         view = cocoa_view_of_window([event window]);
         break;
     default:
         break;
     }
     if (![view handleEvent:event]) {
         [super sendEvent: event];
     }
 }
