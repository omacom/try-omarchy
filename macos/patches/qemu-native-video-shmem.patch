+static void video_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    PCIDeviceClass *pc = PCI_DEVICE_CLASS(klass);
+    pc->realize = video_realize;
+    pc->exit = video_unrealize;
+    pc->vendor_id = PCI_VENDOR_ID_REDHAT_QUMRANET;
+    pc->device_id = 0x1110;
+    pc->subsystem_vendor_id = PCI_VENDOR_ID_REDHAT_QUMRANET;
+    pc->subsystem_id = 0x5654;
+    pc->class_id = PCI_CLASS_MEMORY_RAM;
+    pc->revision = 1;
+    dc->desc = "Try Omarchy video frame shared memory";
+    dc->vmsd = &video_vmstate;
+    device_class_set_props(dc, video_properties);
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
