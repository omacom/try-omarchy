+#define COCOA_FULL_SCREEN_TRIES 3
+#define COCOA_FULL_SCREEN_RETRY_NS (2 * NSEC_PER_SEC)
+static void cocoa_enter_full_screen(unsigned index)
+{
+    QemuCocoaHead *head = &heads[index];
 
+    if (!head->full_screen_wanted || !head->window || head->full_screen_entering ||
+        ([head->window styleMask] & NSWindowStyleMaskFullScreen)) {
+        return;
+    }
+    if (head->full_screen_tries > 0 && ![NSApp isActive]) {
+        info_report("Try Omarchy: display %u enters full screen once the app is active",
+                    index + 1);
