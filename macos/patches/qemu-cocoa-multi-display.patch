+/*
+ * The top of the part of a display the guest covers: below the camera strip
+ * when full screen stays out of it (TRYOMARCHY_NOTCH=0), as the launcher
+ * measures it. Read from the environment because the heads are placed before
+ * the display options are.
+ */
+static CGFloat cocoa_display_top(NSScreen *screen)
+{
+    const char *notch = getenv("TRYOMARCHY_NOTCH");
+    CGFloat inset = notch && !strcmp(notch, "0") ? MAX(0, [screen safeAreaInsets].top) : 0;
+
+    return NSMaxY([screen frame]) - inset;
+}
+
+/*
+ * The display at a place on the guest desktop. The launcher lists the Mac's
+ * main display first and places the others from the same arrangement, in
+ * points, so a display is found by its offset from the main one, whatever
+ * else is connected.
+ */
+static NSScreen *cocoa_screen_at_desktop_position(int x, int y)
+{
+    NSArray *screens = [NSScreen screens];
+    NSScreen *main = [screens firstObject];
+
+    if (!main) {
+        return nil;
+    }
+    for (NSScreen *screen in screens) {
+        if (lround(NSMinX([screen frame]) - NSMinX([main frame])) == x - heads[0].desktop_x &&
+            lround(cocoa_display_top(main) - cocoa_display_top(screen)) == y - heads[0].desktop_y) {
+            return screen;
+        }
+    }
+    return nil;
+}
+
+/*
+ * TRYOMARCHY_DISPLAY_LAYOUT names the launcher's arrangement, the Mac's main
+ * display first: "Virtual-1:0x458,Virtual-2:1512x0". Head N-1 shows output
+ * Virtual-N on the display at that place. Without it, or with one entry,
+ * there is one head, as before.
+ */
+static void cocoa_place_heads(void)
+{
+    const char *layout = getenv("TRYOMARCHY_DISPLAY_LAYOUT");
+    g_auto(GStrv) entries = NULL;
+    unsigned placed = 0;
+
+    heads[0].index = 0;
+    if (!layout || !*layout) {
+        return;
+    }
+    entries = g_strsplit(layout, ",", COCOA_MAX_HEADS + 1);
+    for (unsigned i = 0; entries[i] && i < COCOA_MAX_HEADS; i++) {
+        unsigned output;
+        int x, y, end = -1;
+
+        if (sscanf(entries[i], "Virtual-%u:%dx%d%n", &output, &x, &y, &end) != 3 ||
+            end < 0 || entries[i][end] || output != i + 1 ||
+            x < 0 || y < 0 || x > COCOA_MAX_DESKTOP || y > COCOA_MAX_DESKTOP) {
+            warn_report("Try Omarchy: ignoring display layout entry '%s'", entries[i]);
+            break;
+        }
+        heads[i].index = i;
+        heads[i].placed = true;
+        heads[i].desktop_x = x;
+        heads[i].desktop_y = y;
+        placed = i + 1;
+    }
+    head_count = MAX(1, placed);
+}
+
+/*
+ * A window made without a screen is kept on the main display, so a head on
+ * another display gets its frame again once the window exists.
+ */
+static NSScreen *cocoa_first_head_screen(void)
+{
+    NSScreen *screen = nil;
+
+    if (heads[0].placed) {
+        screen = cocoa_screen_at_desktop_position(heads[0].desktop_x, heads[0].desktop_y);
+    }
+    return screen ? screen : [NSScreen mainScreen];
+}
+
+/* A window on its own display for each head after the first. */
+static void cocoa_add_heads(QemuCocoaAppController *controller)
+{
+    unsigned count = head_count;
+
+    head_count = 1;
+    for (unsigned i = 1; i < count; i++) {
+        QemuCocoaHead *head = &heads[i];
+        QemuConsole *con = qemu_console_lookup_by_device_name("omarchy-gpu", i, NULL);
+        NSScreen *screen = cocoa_screen_at_desktop_position(head->desktop_x, head->desktop_y);
+        NSRect frame;
+        NSWindow *window;
+
+        if (!con) {
+            con = qemu_console_lookup_by_index(i);
+        }
+        if (!con || !qemu_console_is_graphic(con)) {
+            warn_report("Try Omarchy: no console for display %u; using %u display(s)", i + 1, i);
+            break;
+        }
+        if (!screen) {
+            warn_report("Try Omarchy: no display at %dx%d for Virtual-%u; using %u display(s)",
+                        head->desktop_x, head->desktop_y, i + 1, i);
+            break;
+        }
+
+        frame = cocoa_window_frame_on(screen);
+        head->dcl.con = con;
+        head->dcl.ops = heads[0].dcl.ops;
+        head->surface = qemu_console_surface(con);
+#ifdef CONFIG_OPENGL
+        head->view = [[QemuCocoaView alloc] initWithFrame:frame cgl:cocoa_cgl head:head];
+#else
+        head->view = [[QemuCocoaView alloc] initWithFrame:frame head:head];
+#endif
+        window = [[NSWindow alloc] initWithContentRect:frame
+            styleMask:[heads[0].window styleMask]
+            backing:NSBackingStoreBuffered defer:NO];
+        if (!head->view || !window) {
+            error_report("(cocoa) can't create a window for display %u", i + 1);
+            exit(1);
+        }
+        [window setAcceptsMouseMovedEvents:YES];
+        [window setCollectionBehavior:NSWindowCollectionBehaviorFullScreenPrimary];
+        [window setTitle:[NSString stringWithFormat:@"%s (%u)",
+                          qemu_name ? qemu_name : "QEMU", i + 1]];
+        [window setContentView:head->view];
+        [window setFrame:[window frameRectForContentRect:frame] display:NO];
+        [window setDelegate:controller];
+        [window orderFront:nil];
+        head->window = window;
+        head_count = i + 1;
+    }
+}
