+        return;
+    }
+    if (head->full_screen_tries++) {
+        info_report("Try Omarchy: display %u did not enter full screen; asking again",
+                    index + 1);
+    }
+    [head->window toggleFullScreen:nil];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, COCOA_FULL_SCREEN_RETRY_NS),
+                   dispatch_get_main_queue(), ^{
