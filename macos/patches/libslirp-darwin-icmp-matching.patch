+/* SPDX-License-Identifier: BSD-3-Clause */
+#include <stdio.h>
+#include <stdlib.h>
+#include "icmp-match.h"
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "failed line %d: %s\n", __LINE__, #x); exit(1); } } while (0)
+static void checksum(uint8_t *p, size_t n)
+{
+    unsigned sum = 0;
+    p[2] = p[3] = 0;
+    for (size_t i = 0; i < n; i += 2)
+        sum += ((unsigned)p[i] << 8) | (i + 1 < n ? p[i + 1] : 0);
+    while (sum >> 16) sum = (sum & 65535) + (sum >> 16);
+    sum = ~sum;
+    p[2] = sum >> 8; p[3] = sum;
+}
+static size_t outer(uint8_t *p, const uint8_t *body, size_t size)
+{
+    uint16_t n = size;
+    memset(p, 0, 20);
+    p[0] = 0x45; p[9] = 1;
+    memcpy(p + 2, &n, 2); /* Darwin socket representation, not wire order. */
+    memset(p + 12, 1, 4);
+    memcpy(p + 20, body, size);
+    checksum(p + 20, size);
+    return size + 20;
+}
+static int match(const uint8_t *p, size_t n, const uint8_t *q, size_t qn)
+{
+    const uint8_t dst[4] = {1, 1, 1, 1};
+    size_t offset = 0;
+    return icmp_match(p, n, q, qn, dst, &offset);
+}
+int main(void)
+{
+    uint8_t q[264] = {8, 0, 0, 0, 0x12, 0x34, 0, 7};
+    uint8_t body[512], p[600], valid[600];
+    for (size_t i = 8; i < sizeof(q); i++) q[i] = i;
+    checksum(q, sizeof(q));
+    memcpy(body, q, sizeof(q)); body[0] = 0;
+    size_t n = outer(p, body, sizeof(q)); memcpy(valid, p, n);
+    CHECK(match(p, n, q, sizeof(q)) == 1);
+    for (size_t i = 0; i < n; i++) CHECK(!match(p, i, q, sizeof(q)));
+    p[n - 1] ^= 1; CHECK(!match(p, n, q, sizeof(q))); memcpy(p, valid, n);
+    p[12] = 2; CHECK(!match(p, n, q, sizeof(q))); memcpy(p, valid, n);
+    for (size_t i = 24; i < n; i++) {
+        p[i] ^= 1; checksum(p + 20, n - 20);
+        CHECK(!match(p, n, q, sizeof(q))); memcpy(p, valid, n);
+    }
+    p[0] = 0x44; CHECK(!match(p, n, q, sizeof(q))); memcpy(p, valid, n);
+    uint16_t fragment = 0x2000; memcpy(p + 6, &fragment, 2);
+    CHECK(!match(p, n, q, sizeof(q)));
+    /* Short and odd-length echo payloads. */
+    for (size_t size = 8; size < 66; size++) {
+        checksum(q, size); memcpy(body, q, size); body[0] = 0;
+        n = outer(p, body, size); CHECK(match(p, n, q, size) == 1);
+    }
+    checksum(q, sizeof(q));
+    for (unsigned type = 3; type <= 11; type += 8) {
+        memset(body, 0, sizeof(body)); body[0] = type;
+        body[8] = 0x45; body[10] = 1; body[11] = 28; body[17] = 1;
+        memset(body + 24, 1, 4); memcpy(body + 28, q, 8);
+        n = outer(p, body, 36); CHECK(match(p, n, q, sizeof(q)) == 2);
+        body[35] ^= 1; n = outer(p, body, 36);
+        CHECK(!match(p, n, q, sizeof(q))); body[35] ^= 1;
+        /* RFC 4884: 128-byte quote followed by unrelated extension data. */
+        memcpy(body + 28, q, 108); body[5] = 32;
+        memset(body + 136, 0xa5, 12);
+        n = outer(p, body, 148); CHECK(match(p, n, q, sizeof(q)) == 2);
+        body[5] = 31; n = outer(p, body, 148); CHECK(!match(p, n, q, sizeof(q)));
+        body[5] = 255; n = outer(p, body, 148); CHECK(!match(p, n, q, sizeof(q)));
+    }
+    puts("ICMP matching regression tests passed");
+    return 0;
+}
