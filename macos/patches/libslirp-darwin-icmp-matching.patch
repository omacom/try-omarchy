+#ifndef SLIRP_ICMP_MATCH_H
+#define SLIRP_ICMP_MATCH_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+/* Darwin ping sockets retain the ICMP identifier. The returned outer IPv4
+ * length excludes its header; length and fragment fields are in host order.
+ * Quoted IPv4 headers within ICMP errors remain in network order. */
+static int icmp_match(const uint8_t *packet, size_t size,
+                      const uint8_t *request, size_t request_size,
+                      const uint8_t destination[4], size_t *offset) {
+    if (size < 20 || packet[0] >> 4 != 4) return 0;
+    size_t h = (packet[0] & 15) * 4;
+    uint16_t payload_size, fragment;
+    memcpy(&payload_size, packet + 2, 2);
+    memcpy(&fragment, packet + 6, 2);
+    size_t total = h + payload_size;
+    if (h < 20 || total < h + 8 || total > size || packet[9] != 1 ||
+        (fragment & 0x3fff) || request_size < 8) return 0;
+    const uint8_t *icmp = packet + h;
+    size_t len = total - h;
+    unsigned sum = 0;
+    for (size_t i = 0; i < len; i += 2)
+        sum += ((unsigned)icmp[i] << 8) | (i + 1 < len ? icmp[i + 1] : 0);
+    while (sum >> 16) sum = (sum & 65535) + (sum >> 16);
+    if (sum != 65535) return 0;
+    *offset = h;
+    if (icmp[0] == 0 && icmp[1] == 0 && len == request_size &&
+        !memcmp(packet + 12, destination, 4) &&
+        !memcmp(icmp + 4, request + 4, request_size - 4)) return 1;
+    if (!((icmp[0] == 3 && icmp[1] <= 15) || (icmp[0] == 11 && icmp[1] <= 1))) return 0;
+    if (len < 8 + 20 + 8) return 0;
+    const uint8_t *quoted = icmp + 8;
+    size_t qh = (quoted[0] & 15) * 4;
+    if (quoted[0] >> 4 != 4 || qh < 20 || len < 8 + qh + 8 ||
+        quoted[9] != 1 || memcmp(quoted + 16, destination, 4)) return 0;
+    size_t datagram_size = len - 8;
+    /* RFC 4884: the sixth ICMP octet bounds the padded original datagram. */
+    if (icmp[5]) {
+        datagram_size = (size_t)icmp[5] * 4;
+        if (datagram_size < 128 || datagram_size > len - 8 ||
+            datagram_size < qh + 8) return 0;
+    }
+    size_t quoted_size = datagram_size - qh;
+    if (quoted_size > request_size) quoted_size = request_size;
+    if (memcmp(quoted + qh, request, quoted_size)) return 0;
+    return 2;
+}
+#endif
