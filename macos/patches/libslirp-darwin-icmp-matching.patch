+/* SPDX-License-Identifier: BSD-3-Clause */
+#include "slirp.h"
+static unsigned replies;
+static unsigned expected_type;
+static unsigned registered;
+static uint16_t sum(const uint8_t *p, size_t n)
+{
+    unsigned v = 0;
+    for (size_t i = 0; i < n; i += 2)
+        v += ((unsigned)p[i] << 8) | (i + 1 < n ? p[i + 1] : 0);
+    while (v >> 16) v = (v & 65535) + (v >> 16);
+    return (uint16_t)~v;
+}
+static void checksum(uint8_t *p, size_t n)
+{
+    p[2] = p[3] = 0;
+    uint16_t v = sum(p, n); p[2] = v >> 8; p[3] = v;
+}
+static slirp_ssize_t output(const void *buf, size_t len, void *opaque)
+{
+    const uint8_t *p = buf;
+    if (len < 42 || p[12] != 8 || p[13] != 0) return len;
+    g_assert_cmpuint(p[34], ==, expected_type);
+    size_t iplen = ((size_t)p[16] << 8) | p[17];
+    g_assert_cmpuint(iplen + 14, <=, len);
+    g_assert_cmpuint(sum(p + 34, iplen - 20), ==, 0);
+    if (expected_type == 3) {
+        g_assert_cmpuint(p[35], ==, 4);
+        g_assert_cmpuint(((unsigned)p[40] << 8) | p[41], ==, 1400);
+        g_assert_cmpuint(p[26], ==, 9);
+        g_assert_cmpuint(p[27], ==, 9);
+        g_assert_cmpuint(p[28], ==, 9);
+        g_assert_cmpuint(p[29], ==, 9);
+        g_assert_cmpuint(p[66], ==, 0x12);
+        g_assert_cmpuint(p[67], ==, 0x34);
+        g_assert_cmpuint(p[69], ==, 7);
+    } else {
+        g_assert_cmpuint(p[38], ==, 0x12);
+        g_assert_cmpuint(p[39], ==, 0x34);
+        g_assert_cmpuint(p[41], ==, 7);
+    }
+    replies++;
+    return len;
+}
+static int64_t now(void *opaque) { return 0; }
+static void reg(slirp_os_socket fd, void *opaque) { registered++; }
+static void unreg(slirp_os_socket fd, void *opaque) { registered--; }
+static void notify(void *opaque) { }
+static struct socket *pending(Slirp *slirp, int fds[2])
+{
+    struct mbuf *m = m_get(slirp);
+    m->m_len = 32; memset(m->m_data, 0, 32);
+    struct ip *ip = mtod(m, struct ip *);
+    ip->ip_v = 4; ip->ip_hl = 5; ip->ip_len = 32;
+    ip->ip_ttl = 64; ip->ip_p = 1;
+    ip->ip_src.s_addr = htonl(0x0a00020e);
+    ip->ip_dst.s_addr = htonl(0x01010101);
+    uint8_t *q = (uint8_t *)m->m_data + 20;
+    q[0] = 8; q[4] = 0x12; q[5] = 0x34; q[7] = 7;
+    q[8] = 1; q[9] = 2; q[10] = 3; q[11] = 4; checksum(q, 12);
+    g_assert_cmpint(socketpair(AF_UNIX, SOCK_DGRAM, 0, fds), ==, 0);
+    struct socket *so = socreate(slirp, IPPROTO_IP);
+    so->s = fds[0]; so->so_m = m; so->so_faddr = ip->ip_dst;
+    so->so_laddr = ip->ip_src; so->so_state = SS_ISFCONNECTED;
+    slirp_insque(so, &slirp->icmp); slirp_register_poll_socket(so);
+    return so;
+}
+int main(void)
+{
+    SlirpConfig cfg = {.version = 6, .in_enabled = true,
+        .vnetwork.s_addr = htonl(0x0a000200), .vnetmask.s_addr = htonl(0xffffff00),
+        .vhost.s_addr = htonl(0x0a000202), .vdhcp_start.s_addr = htonl(0x0a00020f),
+        .vnameserver.s_addr = htonl(0x0a000203)};
+    SlirpCb cb = {.send_packet = output, .clock_get_ns = now,
+        .register_poll_socket = reg, .unregister_poll_socket = unreg, .notify = notify};
+    Slirp *slirp = slirp_new(&cfg, &cb, NULL); g_assert_nonnull(slirp);
+    const uint8_t mac[6] = {0x52, 0x55, 0x0a, 0, 2, 14};
+    arp_table_add(slirp, htonl(0x0a00020e), mac);
+    int fds[2]; struct socket *so = pending(slirp, fds);
+    uint8_t packet[56] = {0}, original[32];
+    memcpy(original, so->so_m->m_data, 32);
+    packet[0] = 0x45; uint16_t size = 12; memcpy(packet + 2, &size, 2);
+    packet[9] = 1; memset(packet + 12, 1, 4);
+    memcpy(packet + 20, original + 20, 12); packet[20] = 0;
+    packet[27] = 8; checksum(packet + 20, 12);
+    g_assert_cmpint(send(fds[1], packet, 32, 0), ==, 32);
+    icmp_receive(so);
+    g_assert_cmpuint(replies, ==, 0); g_assert_cmpuint(registered, ==, 1);
+    g_assert_cmpint(memcmp(original, so->so_m->m_data, 32), ==, 0);
+    packet[27] = 7; checksum(packet + 20, 12);
+    g_assert_cmpint(send(fds[1], packet, 32, 0), ==, 32);
+    icmp_receive(so);
+    g_assert_cmpuint(replies, ==, 1); g_assert_cmpuint(registered, ==, 0); close(fds[1]);
+    so = pending(slirp, fds); expected_type = 3;
+    memset(packet, 0, sizeof(packet)); packet[0] = 0x45;
+    size = 36; memcpy(packet + 2, &size, 2); packet[9] = 1;
+    memset(packet + 12, 9, 4); packet[20] = 3; packet[21] = 4;
+    packet[26] = 5; packet[27] = 120;
+    memcpy(packet + 28, original, 28); packet[30] = 0; packet[31] = 32;
+    checksum(packet + 20, 36);
+    g_assert_cmpint(send(fds[1], packet, sizeof(packet), 0), ==, sizeof(packet));
+    icmp_receive(so);
+    g_assert_cmpuint(replies, ==, 2); g_assert_cmpuint(registered, ==, 0);
+    close(fds[1]); slirp_cleanup(slirp);
+    puts("Darwin ICMP receive regression tests passed");
+    return 0;
+}
