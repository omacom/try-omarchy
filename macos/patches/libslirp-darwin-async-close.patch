diff --git a/src/close-worker.c b/src/close-worker.c
--- /dev/null
+++ b/src/close-worker.c
@@ -0,0 +1,416 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#if defined(__APPLE__) && !defined(_DARWIN_C_SOURCE)
+#define _DARWIN_C_SOURCE 1
+#endif
+#include "close-worker.h"
+
+#ifdef SLIRP_ASYNC_CLOSE
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <time.h>
+#ifdef __APPLE__
+#include <os/os_sync_wait_on_address.h>
+#endif
+
+struct SlirpCloseTicket {
+    SlirpClosePool *pool;
+    SlirpCloseTicket *next;
+    int fd;
+};
+
+struct SlirpClosePool {
+    pthread_mutex_t lock;
+    pthread_cond_t ready;
+    pthread_cond_t monitor_changed;
+#ifdef __APPLE__
+    uint64_t ready_generation __attribute__((aligned(8)));
+    bool ready_fallback;
+#endif
+    unsigned references;
+    size_t reserved;
+    bool stopped;
+    unsigned sleeping;
+    bool wake_pending;
+    unsigned busy;
+    unsigned service_limit;
+    bool monitoring;
+    bool timer_failed;
+    uint64_t completed;
+    int (*close_fd)(int);
+    SlirpCloseTicket *head;
+    SlirpCloseTicket *tail;
+};
+
+#ifdef __APPLE__
+static void native_ready_wake(SlirpClosePool *pool, bool all)
+{
+    int saved_errno = errno;
+    int result = all ?
+                     os_sync_wake_by_address_all(&pool->ready_generation, 8,
+                                                 OS_SYNC_WAKE_BY_ADDRESS_NONE) :
+                     os_sync_wake_by_address_any(&pool->ready_generation, 8,
+                                                 OS_SYNC_WAKE_BY_ADDRESS_NONE);
+    int error = errno;
+    errno = saved_errno;
+    /* The generation may change before a waiter enters the kernel.
+     * https://github.com/apple-oss-distributions/xnu/blob/main/bsd/kern/sys_ulock.c
+     */
+    if (result < 0 && error != ENOENT) {
+        assert(!"native ready wake failed");
+    }
+}
+
+static void ready_use_fallback(SlirpClosePool *pool)
+{
+    if (!pool->ready_fallback) {
+        pool->ready_fallback = true;
+        /* Delayed waiters must see a changed value after fallback. */
+        __atomic_store_n(&pool->ready_generation, UINT64_MAX, __ATOMIC_RELEASE);
+        native_ready_wake(pool, true);
+        pthread_cond_broadcast(&pool->ready);
+    }
+}
+#endif
+
+static void ready_wake(SlirpClosePool *pool, bool all)
+{
+#ifdef __APPLE__
+    if (!pool->ready_fallback) {
+        uint64_t generation =
+            __atomic_load_n(&pool->ready_generation, __ATOMIC_RELAXED);
+        if (generation >= UINT64_MAX - 1) {
+            ready_use_fallback(pool);
+            return;
+        }
+        __atomic_store_n(&pool->ready_generation, generation + 1,
+                         __ATOMIC_RELEASE);
+        native_ready_wake(pool, all);
+        return;
+    }
+#endif
+    if (all) {
+        pthread_cond_broadcast(&pool->ready);
+    } else {
+        pthread_cond_signal(&pool->ready);
+    }
+}
+
+static void ready_wait(SlirpClosePool *pool)
+{
+#ifdef __APPLE__
+    if (!pool->ready_fallback) {
+        uint64_t generation =
+            __atomic_load_n(&pool->ready_generation, __ATOMIC_RELAXED);
+        pthread_mutex_unlock(&pool->lock);
+        int result =
+            os_sync_wait_on_address(&pool->ready_generation, generation, 8,
+                                    OS_SYNC_WAIT_ON_ADDRESS_NONE);
+        int error = errno;
+        pthread_mutex_lock(&pool->lock);
+        if (result < 0 && error != EINTR) {
+            ready_use_fallback(pool);
+        }
+        return;
+    }
+#endif
+    pthread_cond_wait(&pool->ready, &pool->lock);
+}
+
+static void pool_destroy(SlirpClosePool *pool)
+{
+    pthread_cond_destroy(&pool->monitor_changed);
+    pthread_cond_destroy(&pool->ready);
+    pthread_mutex_destroy(&pool->lock);
+    free(pool);
+}
+
+static void wake_worker(SlirpClosePool *pool)
+{
+    if (pool->head && pool->sleeping && !pool->wake_pending &&
+        (pool->busy < pool->service_limit ||
+         (!pool->monitoring && pool->service_limit < SLIRP_CLOSE_WORKERS))) {
+        pool->wake_pending = true;
+        ready_wake(pool, false);
+    }
+}
+
+#define CLOSE_PROGRESS_NS 1000000
+
+static bool monotonic_now(uint64_t *now)
+{
+    struct timespec time;
+    if (clock_gettime(CLOCK_MONOTONIC, &time) || time.tv_sec < 0 ||
+        time.tv_nsec < 0 || time.tv_nsec >= 1000000000 ||
+        (uint64_t)time.tv_sec > (UINT64_MAX - 999999999) / 1000000000) {
+        return false;
+    }
+    *now = (uint64_t)time.tv_sec * 1000000000 + (uint64_t)time.tv_nsec;
+    return *now <= UINT64_MAX - CLOSE_PROGRESS_NS;
+}
+
+static void full_service(SlirpClosePool *pool)
+{
+    pool->timer_failed = true;
+    pool->service_limit = SLIRP_CLOSE_WORKERS;
+    ready_wake(pool, true);
+}
+
+static void monitor_progress(SlirpClosePool *pool)
+{
+    uint64_t completed = pool->completed;
+    uint64_t now;
+    uint64_t deadline;
+
+    if (!monotonic_now(&now)) {
+        full_service(pool);
+        return;
+    }
+    deadline = now + CLOSE_PROGRESS_NS;
+    while (pool->head && !pool->stopped &&
+           pool->service_limit < SLIRP_CLOSE_WORKERS) {
+        if (!monotonic_now(&now)) {
+            full_service(pool);
+            return;
+        }
+        if (now >= deadline) {
+            if (pool->completed == completed) {
+                pool->service_limit++;
+                wake_worker(pool);
+            }
+            completed = pool->completed;
+            deadline = now + CLOSE_PROGRESS_NS;
+            if (pool->service_limit == SLIRP_CLOSE_WORKERS) {
+                break;
+            }
+        }
+#ifdef __APPLE__
+        uint64_t remaining = deadline - now;
+        struct timespec delay = {
+            .tv_sec = (time_t)(remaining / 1000000000),
+            .tv_nsec = (long)(remaining % 1000000000),
+        };
+        int err = pthread_cond_timedwait_relative_np(&pool->monitor_changed,
+                                                     &pool->lock, &delay);
+#else
+        uint64_t seconds = deadline / 1000000000;
+        struct timespec absolute = {
+            .tv_sec = (time_t)seconds,
+            .tv_nsec = (long)(deadline % 1000000000),
+        };
+        int err = absolute.tv_sec < 0 || (uint64_t)absolute.tv_sec != seconds ?
+                      EOVERFLOW :
+                      pthread_cond_timedwait(&pool->monitor_changed,
+                                             &pool->lock, &absolute);
+#endif
+        if (err && err != ETIMEDOUT) {
+            full_service(pool);
+            return;
+        }
+    }
+}
+
+static void *close_worker(void *opaque)
+{
+    SlirpClosePool *pool = opaque;
+    bool destroy;
+
+    pthread_mutex_lock(&pool->lock);
+    for (;;) {
+        SlirpCloseTicket *ticket;
+        if (pool->stopped && pool->sleeping) {
+            ready_wake(pool, false);
+        }
+        if (!pool->head) {
+            if (pool->stopped) {
+                break;
+            }
+            if (!pool->busy && !pool->timer_failed) {
+                pool->service_limit = 1;
+            }
+        } else if (pool->stopped || pool->busy < pool->service_limit) {
+            ticket = pool->head;
+            pool->head = ticket->next;
+            if (!pool->head) {
+                pool->tail = NULL;
+                if (pool->monitoring) {
+                    pthread_cond_signal(&pool->monitor_changed);
+                }
+            }
+            pool->busy++;
+            if (!pool->stopped) {
+                wake_worker(pool);
+            }
+            pthread_mutex_unlock(&pool->lock);
+
+            /* Never retry close: an interrupted call may have released the fd.
+             */
+            pool->close_fd(ticket->fd);
+            free(ticket);
+
+            pthread_mutex_lock(&pool->lock);
+            pool->busy--;
+            pool->completed++;
+            continue;
+        } else if (!pool->monitoring &&
+                   pool->service_limit < SLIRP_CLOSE_WORKERS) {
+            pool->monitoring = true;
+            monitor_progress(pool);
+            pool->monitoring = false;
+            continue;
+        }
+        pool->sleeping++;
+        ready_wait(pool);
+        pool->sleeping--;
+        pool->wake_pending = false;
+    }
+    destroy = --pool->references == 0;
+    pthread_mutex_unlock(&pool->lock);
+    if (destroy) {
+        pool_destroy(pool);
+    }
+    return NULL;
+}
+
+SlirpClosePool *slirp_close_pool_new(int (*close_fd)(int))
+{
+    SlirpClosePool *pool = calloc(1, sizeof(*pool));
+    pthread_attr_t attr;
+    int err;
+    unsigned i;
+
+    if (!pool) {
+        return NULL;
+    }
+    pool->references = 1;
+    pool->close_fd = close_fd;
+    pool->service_limit = 1;
+#ifdef __APPLE__
+    __atomic_store_n(&pool->ready_generation, 0, __ATOMIC_RELAXED);
+#endif
+    err = pthread_mutex_init(&pool->lock, NULL);
+    if (err) {
+        free(pool);
+        errno = err;
+        return NULL;
+    }
+    err = pthread_cond_init(&pool->ready, NULL);
+    if (err) {
+        pthread_mutex_destroy(&pool->lock);
+        free(pool);
+        errno = err;
+        return NULL;
+    }
+#ifdef __APPLE__
+    err = pthread_cond_init(&pool->monitor_changed, NULL);
+#else
+    pthread_condattr_t monitor_attr;
+    err = pthread_condattr_init(&monitor_attr);
+    if (!err) {
+        err = pthread_condattr_setclock(&monitor_attr, CLOCK_MONOTONIC);
+        if (!err) {
+            err = pthread_cond_init(&pool->monitor_changed, &monitor_attr);
+        }
+        pthread_condattr_destroy(&monitor_attr);
+    }
+#endif
+    if (err) {
+        pthread_cond_destroy(&pool->ready);
+        pthread_mutex_destroy(&pool->lock);
+        free(pool);
+        errno = err;
+        return NULL;
+    }
+    err = pthread_attr_init(&attr);
+    if (err) {
+        pool_destroy(pool);
+        errno = err;
+        return NULL;
+    }
+    err = pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    if (!err) {
+        for (i = 0; i < SLIRP_CLOSE_WORKERS; i++) {
+            pthread_t thread;
+            pthread_mutex_lock(&pool->lock);
+            pool->references++;
+            err = pthread_create(&thread, &attr, close_worker, pool);
+            if (err) {
+                pool->references--;
+            }
+            pthread_mutex_unlock(&pool->lock);
+            if (err) {
+                break;
+            }
+        }
+    }
+    pthread_attr_destroy(&attr);
+    if (err) {
+        slirp_close_pool_free(pool);
+        errno = err;
+        return NULL;
+    }
+    return pool;
+}
+
+SlirpCloseTicket *slirp_close_reserve(SlirpClosePool *pool)
+{
+    SlirpCloseTicket *ticket = malloc(sizeof(*ticket));
+
+    if (!ticket) {
+        errno = ENOMEM;
+        return NULL;
+    }
+    ticket->pool = pool;
+    pthread_mutex_lock(&pool->lock);
+    assert(!pool->stopped);
+    pool->reserved++;
+    pthread_mutex_unlock(&pool->lock);
+    return ticket;
+}
+
+void slirp_close_cancel(SlirpCloseTicket *ticket)
+{
+    SlirpClosePool *pool = ticket->pool;
+    pthread_mutex_lock(&pool->lock);
+    pool->reserved--;
+    pthread_mutex_unlock(&pool->lock);
+    free(ticket);
+}
+
+void slirp_close_submit(SlirpCloseTicket *ticket, int fd)
+{
+    SlirpClosePool *pool = ticket->pool;
+    pthread_mutex_lock(&pool->lock);
+    assert(!pool->stopped);
+    pool->reserved--;
+    ticket->fd = fd;
+    ticket->next = NULL;
+    if (pool->tail) {
+        pool->tail->next = ticket;
+    } else {
+        pool->head = ticket;
+    }
+    pool->tail = ticket;
+    wake_worker(pool);
+    pthread_mutex_unlock(&pool->lock);
+}
+
+void slirp_close_pool_free(SlirpClosePool *pool)
+{
+    bool destroy;
+    pthread_mutex_lock(&pool->lock);
+    assert(pool->reserved == 0);
+    pool->stopped = true;
+    pool->service_limit = SLIRP_CLOSE_WORKERS;
+    ready_wake(pool, false);
+    pthread_cond_broadcast(&pool->monitor_changed);
+    destroy = --pool->references == 0;
+    pthread_mutex_unlock(&pool->lock);
+    if (destroy) {
+        pool_destroy(pool);
+    }
+}
+#endif
