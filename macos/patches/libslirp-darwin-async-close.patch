diff --git a/test/close-worker-test.c b/test/close-worker-test.c
--- /dev/null
+++ b/test/close-worker-test.c
@@ -0,0 +1,230 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#if defined(__APPLE__) && !defined(_DARWIN_C_SOURCE)
+#define _DARWIN_C_SOURCE 1
+#endif
+#define _POSIX_C_SOURCE 200809L
+#undef NDEBUG
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <time.h>
+#include <unistd.h>
+
+#define TEST_CONNECTIONS 32768
+
+static bool fail_allocation;
+static int create_count;
+static int fail_create = -1;
+
+static int test_pthread_create(pthread_t *thread, const pthread_attr_t *attr,
+                               void *(*entry)(void *), void *opaque)
+{
+    if (create_count++ == fail_create) {
+        return EAGAIN;
+    }
+    return pthread_create(thread, attr, entry, opaque);
+}
+
+static void *test_malloc(size_t size)
+{
+    if (fail_allocation) {
+        errno = ENOMEM;
+        return NULL;
+    }
+    return malloc(size);
+}
+
+#define malloc test_malloc
+#define pthread_create test_pthread_create
+#include "../src/close-worker.c"
+#undef pthread_create
+#undef malloc
+
+static pthread_mutex_t gate = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t changed = PTHREAD_COND_INITIALIZER;
+static bool release_closes;
+static int entered;
+static int finished;
+static int seen[TEST_CONNECTIONS];
+
+static int stalled_close(int fd)
+{
+    pthread_mutex_lock(&gate);
+    assert(fd >= 0 && fd < TEST_CONNECTIONS);
+    assert(++seen[fd] == 1);
+    entered++;
+    pthread_cond_broadcast(&changed);
+    while (!release_closes) {
+        pthread_cond_wait(&changed, &gate);
+    }
+    finished++;
+    pthread_cond_broadcast(&changed);
+    pthread_mutex_unlock(&gate);
+    errno = EINTR;
+    return -1;
+}
+
+static void test_stalled_closes(void)
+{
+    SlirpClosePool *pool = slirp_close_pool_new(stalled_close);
+    SlirpCloseTicket *tickets[TEST_CONNECTIONS];
+    unsigned i;
+
+    assert(pool);
+    for (i = 0; i < TEST_CONNECTIONS; i++) {
+        tickets[i] = slirp_close_reserve(pool);
+        assert(tickets[i]);
+    }
+    slirp_close_cancel(tickets[0]);
+    tickets[0] = slirp_close_reserve(pool);
+    assert(tickets[0]);
+
+    for (i = 0; i < TEST_CONNECTIONS; i++) {
+        slirp_close_submit(tickets[i], (int)i);
+    }
+    pthread_mutex_lock(&gate);
+    while (entered < SLIRP_CLOSE_WORKERS) {
+        pthread_cond_wait(&changed, &gate);
+    }
+    assert(entered == SLIRP_CLOSE_WORKERS);
+    assert(finished == 0);
+    pthread_mutex_unlock(&gate);
+
+    for (i = 0; i < TEST_CONNECTIONS; i++) {
+        tickets[i] = slirp_close_reserve(pool);
+        assert(tickets[i]);
+    }
+    for (i = 0; i < TEST_CONNECTIONS; i++) {
+        slirp_close_cancel(tickets[i]);
+    }
+    slirp_close_pool_free(pool);
+
+    pthread_mutex_lock(&gate);
+    assert(finished == 0);
+    release_closes = true;
+    pthread_cond_broadcast(&changed);
+    while (finished < TEST_CONNECTIONS) {
+        pthread_cond_wait(&changed, &gate);
+    }
+    for (i = 0; i < TEST_CONNECTIONS; i++) {
+        assert(seen[i] == 1);
+    }
+    pthread_mutex_unlock(&gate);
+    puts("PASS: 32768 stalled closes, new reservations, cancellation, "
+         "asynchronous teardown, EINTR without retry");
+}
+
+static void test_data_and_eof(void)
+{
+    SlirpClosePool *pool = slirp_close_pool_new(close);
+    SlirpCloseTicket *ticket;
+    int pair[2];
+    char sent[1024], received[sizeof(sent)];
+    size_t written = 0, read_bytes = 0;
+    ssize_t count;
+
+    assert(pool);
+    memset(sent, 'T', sizeof(sent));
+    assert(socketpair(AF_UNIX, SOCK_STREAM, 0, pair) == 0);
+    while (written < sizeof(sent)) {
+        count = write(pair[0], sent + written, sizeof(sent) - written);
+        assert(count > 0);
+        written += count;
+    }
+    ticket = slirp_close_reserve(pool);
+    assert(ticket);
+    slirp_close_submit(ticket, pair[0]);
+    slirp_close_pool_free(pool);
+    while (read_bytes < sizeof(received)) {
+        count =
+            read(pair[1], received + read_bytes, sizeof(received) - read_bytes);
+        assert(count > 0);
+        read_bytes += count;
+    }
+    assert(memcmp(sent, received, sizeof(sent)) == 0);
+    assert(read(pair[1], received, 1) == 0);
+    close(pair[1]);
+    puts("PASS: queued payload and EOF survive pool teardown");
+}
+
+static void test_thread_creation_failure(void)
+{
+    int i;
+    for (i = 0; i < SLIRP_CLOSE_WORKERS; i++) {
+        create_count = 0;
+        fail_create = i;
+        assert(!slirp_close_pool_new(close));
+        assert(errno == EAGAIN);
+    }
+    fail_create = -1;
+    puts("PASS: failure at each worker creation returns without a synchronous "
+         "fallback");
+}
+
+static int count_close(int fd)
+{
+    (void)fd;
+    pthread_mutex_lock(&gate);
+    finished++;
+    pthread_cond_broadcast(&changed);
+    pthread_mutex_unlock(&gate);
+    return 0;
+}
+
+static void test_repeated_closes(void)
+{
+    SlirpClosePool *pool = slirp_close_pool_new(count_close);
+    int i;
+    assert(pool);
+    pthread_mutex_lock(&gate);
+    finished = 0;
+    pthread_mutex_unlock(&gate);
+    for (i = 0; i < 2 * TEST_CONNECTIONS; i++) {
+        SlirpCloseTicket *ticket = slirp_close_reserve(pool);
+        assert(ticket);
+        slirp_close_submit(ticket, 0);
+    }
+    slirp_close_pool_free(pool);
+    pthread_mutex_lock(&gate);
+    while (finished < 2 * TEST_CONNECTIONS) {
+        pthread_cond_wait(&changed, &gate);
+    }
+    pthread_mutex_unlock(&gate);
+    puts("PASS: 65536 repeated closes complete");
+}
+
+static void test_allocation_failure(void)
+{
+    SlirpClosePool *pool = slirp_close_pool_new(close);
+    SlirpCloseTicket *ticket;
+
+    assert(pool);
+    ticket = slirp_close_reserve(pool);
+    assert(ticket);
+    fail_allocation = true;
+    assert(!slirp_close_reserve(pool) && errno == ENOMEM);
+    slirp_close_cancel(ticket);
+    fail_allocation = false;
+    ticket = slirp_close_reserve(pool);
+    assert(ticket);
+    slirp_close_cancel(ticket);
+    slirp_close_pool_free(pool);
+    puts("PASS: allocation failure preserves existing reservations and "
+         "recovers");
+}
+
+int main(void)
+{
+    alarm(25);
+    test_thread_creation_failure();
+    test_stalled_closes();
+    test_data_and_eof();
+    test_repeated_closes();
+    test_allocation_failure();
+    return 0;
+}
diff --git a/test/tcp-close-test.c b/test/tcp-close-test.c
--- /dev/null
+++ b/test/tcp-close-test.c
@@ -0,0 +1,207 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#undef NDEBUG
+#include "slirp.h"
+#include <assert.h>
+#include <poll.h>
+#include <pthread.h>
+
+static pthread_t owner;
+static pthread_mutex_t gate = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t changed = PTHREAD_COND_INITIALIZER;
+static bool release_closes;
+static unsigned closed_count;
+static unsigned unregister_count;
+static bool registered[4096];
+
+static void register_fd(slirp_os_socket fd, void *opaque)
+{
+    (void)opaque;
+    assert(pthread_equal(pthread_self(), owner));
+    assert(fd >= 0 && fd < (int)G_N_ELEMENTS(registered));
+    assert(!registered[fd]);
+    registered[fd] = true;
+}
+
+static void unregister_fd(slirp_os_socket fd, void *opaque)
+{
+    (void)opaque;
+    assert(pthread_equal(pthread_self(), owner));
+    if (fd >= 0) {
+        assert(fd < (int)G_N_ELEMENTS(registered));
+        registered[fd] = false;
+        unregister_count++;
+    }
+}
+
+static int stalled_close(int fd)
+{
+    int result;
+    assert(!pthread_equal(pthread_self(), owner));
+    assert(fd >= 0 && fd < (int)G_N_ELEMENTS(registered));
+    assert(!registered[fd]);
+    pthread_mutex_lock(&gate);
+    while (!release_closes) {
+        pthread_cond_wait(&changed, &gate);
+    }
+    result = close(fd);
+    assert(result == 0);
+    closed_count++;
+    pthread_cond_broadcast(&changed);
+    pthread_mutex_unlock(&gate);
+    return result;
+}
+
+static Slirp *new_slirp(void)
+{
+    static const SlirpCb callbacks = {
+        .register_poll_socket = register_fd,
+        .unregister_poll_socket = unregister_fd,
+    };
+    SlirpConfig cfg = { 0 };
+    Slirp *slirp;
+    cfg.version = 6;
+    cfg.in_enabled = true;
+    inet_pton(AF_INET, "10.0.2.0", &cfg.vnetwork);
+    inet_pton(AF_INET, "255.255.255.0", &cfg.vnetmask);
+    inet_pton(AF_INET, "10.0.2.2", &cfg.vhost);
+    slirp = slirp_new(&cfg, &callbacks, NULL);
+    assert(slirp);
+    slirp_close_pool_free(slirp->close_pool);
+    slirp->close_pool = slirp_close_pool_new(stalled_close);
+    assert(slirp->close_pool);
+    return slirp;
+}
+
+static void test_socket_failure(void)
+{
+    Slirp *slirp = new_slirp();
+    struct socket *so;
+
+    so = socreate(slirp, IPPROTO_TCP);
+    tcp_attach(so);
+    assert(tcp_fconnect(so, AF_UNSPEC) == -1);
+    assert(!so->close_ticket && so->s == SLIRP_INVALID_SOCKET);
+    tcp_close(so->so_tcpcb);
+    slirp_cleanup(slirp);
+    puts("PASS: socket creation failure releases its cleanup record");
+}
+
+static void test_bind_failure(void)
+{
+    Slirp *slirp = new_slirp();
+    struct socket *so = socreate(slirp, IPPROTO_TCP);
+    struct sockaddr_in bad_source = { 0 };
+    bad_source.sin_family = AF_INET6;
+    slirp->outbound_addr = &bad_source;
+    tcp_attach(so);
+    assert(tcp_fconnect(so, AF_INET) == -1);
+    assert(errno == EAFNOSUPPORT || errno == EINVAL);
+    assert(!so->close_ticket && so->s == SLIRP_INVALID_SOCKET);
+    tcp_close(so->so_tcpcb);
+    slirp_cleanup(slirp);
+    pthread_mutex_lock(&gate);
+    assert(closed_count == 0);
+    release_closes = true;
+    pthread_cond_broadcast(&changed);
+    while (closed_count != 1) {
+        pthread_cond_wait(&changed, &gate);
+    }
+    release_closes = false;
+    closed_count = 0;
+    pthread_mutex_unlock(&gate);
+    puts("PASS: failed outbound bind hands off its descriptor exactly once and "
+         "preserves errno");
+}
+
+static void test_tcp_lifecycle(int family)
+{
+    Slirp *slirp = new_slirp();
+    struct sockaddr_storage addr = { 0 };
+    socklen_t len;
+    struct socket *so[2];
+    int listener, peers[2];
+    unsigned i;
+    static const char payload[] = "queued TCP data survives deferred close";
+    char received[sizeof(payload)];
+
+    listener = socket(family, SOCK_STREAM, 0);
+    assert(listener >= 0);
+    addr.ss_family = family;
+    if (family == AF_INET) {
+        struct sockaddr_in *a = (struct sockaddr_in *)&addr;
+        a->sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+        len = sizeof(*a);
+    } else {
+        struct sockaddr_in6 *a = (struct sockaddr_in6 *)&addr;
+        a->sin6_addr = in6addr_loopback;
+        len = sizeof(*a);
+    }
+    assert(bind(listener, (struct sockaddr *)&addr, len) == 0);
+    assert(listen(listener, 2) == 0);
+    assert(getsockname(listener, (struct sockaddr *)&addr, &len) == 0);
+
+    for (i = 0; i < 2; i++) {
+        struct pollfd pfd;
+        int result;
+        so[i] = socreate(slirp, IPPROTO_TCP);
+        so[i]->fhost.ss = addr;
+        tcp_attach(so[i]);
+        result = tcp_fconnect(so[i], family);
+        assert(result == 0 || errno == EINPROGRESS);
+        assert(so[i]->close_ticket);
+        pfd.fd = listener;
+        pfd.events = POLLIN;
+        assert(poll(&pfd, 1, 5000) == 1);
+        peers[i] = accept(listener, NULL, NULL);
+        assert(peers[i] >= 0);
+        pfd.fd = so[i]->s;
+        pfd.events = POLLOUT;
+        assert(poll(&pfd, 1, 5000) == 1);
+        assert(write(so[i]->s, payload, sizeof(payload)) == sizeof(payload));
+    }
+    tcp_close(so[0]->so_tcpcb);
+    slirp_cleanup(slirp);
+    assert(unregister_count == 2);
+
+    pthread_mutex_lock(&gate);
+    assert(closed_count == 0);
+    release_closes = true;
+    pthread_cond_broadcast(&changed);
+    while (closed_count != 2) {
+        pthread_cond_wait(&changed, &gate);
+    }
+    pthread_mutex_unlock(&gate);
+
+    for (i = 0; i < 2; i++) {
+        size_t total = 0;
+        while (total < sizeof(received)) {
+            ssize_t n =
+                read(peers[i], received + total, sizeof(received) - total);
+            assert(n > 0);
+            total += n;
+        }
+        assert(!memcmp(received, payload, sizeof(payload)));
+        assert(read(peers[i], received, 1) == 0);
+        close(peers[i]);
+    }
+    close(listener);
+    pthread_mutex_lock(&gate);
+    release_closes = false;
+    closed_count = 0;
+    pthread_mutex_unlock(&gate);
+    unregister_count = 0;
+    printf("PASS: IPv%d connect, poll removal, tcp_close and slirp_cleanup "
+           "return while close is stalled; payload and EOF intact\n",
+           family == AF_INET ? 4 : 6);
+}
+
+int main(void)
+{
+    alarm(25);
+    owner = pthread_self();
+    test_socket_failure();
+    test_bind_failure();
+    test_tcp_lifecycle(AF_INET);
+    test_tcp_lifecycle(AF_INET6);
+    return 0;
+}
diff --git a/test/close-worker-adaptive-test.c b/test/close-worker-adaptive-test.c
--- /dev/null
+++ b/test/close-worker-adaptive-test.c
@@ -0,0 +1,462 @@
+#define _DARWIN_C_SOURCE 1
+#define _POSIX_C_SOURCE 200809L
+#undef NDEBUG
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include <unistd.h>
+
+static atomic_int allocations;
+static atomic_int frees;
+static atomic_int clock_calls;
+static atomic_int timer_calls;
+static atomic_int timer_active;
+static atomic_int clock_failure;
+static atomic_bool fail_timer;
+static atomic_bool virtual_time;
+static atomic_uint_fast64_t virtual_now;
+static atomic_int allowed_wait;
+static atomic_bool stop_wait;
+static atomic_int waits_entered;
+static atomic_uint_fast64_t requested_delay[64];
+static _Atomic(pthread_cond_t *) monitor_condition;
+static _Atomic(pthread_t) monitor_thread;
+
+static void *checked_malloc(size_t size)
+{
+    void *p = malloc(size);
+    if (p) {
+        atomic_fetch_add(&allocations, 1);
+    }
+    return p;
+}
+
+static void *checked_calloc(size_t n, size_t size)
+{
+    void *p = calloc(n, size);
+    if (p) {
+        atomic_fetch_add(&allocations, 1);
+    }
+    return p;
+}
+
+static void checked_free(void *p)
+{
+    if (p) {
+        free(p);
+        atomic_fetch_add(&frees, 1);
+    }
+}
+
+static int checked_clock(clockid_t kind, struct timespec *now)
+{
+    assert(kind == CLOCK_MONOTONIC);
+    atomic_fetch_add(&clock_calls, 1);
+    int failure = atomic_exchange(&clock_failure, 0);
+    if (failure == 1) {
+        errno = EIO;
+        return -1;
+    }
+    if (failure == 2) {
+        now->tv_sec = -1;
+        now->tv_nsec = 0;
+        return 0;
+    }
+    if (failure == 3) {
+        now->tv_sec = 1;
+        now->tv_nsec = 1000000000;
+        return 0;
+    }
+    if (failure == 4) {
+        now->tv_sec = INT64_MAX;
+        now->tv_nsec = 0;
+        return 0;
+    }
+    if (atomic_load(&virtual_time)) {
+        uint64_t ns = atomic_load(&virtual_now);
+        now->tv_sec = (time_t)(ns / 1000000000);
+        now->tv_nsec = (long)(ns % 1000000000);
+        return 0;
+    }
+    return clock_gettime(kind, now);
+}
+
+static int checked_timer(pthread_cond_t *condition, pthread_mutex_t *mutex,
+                         const struct timespec *relative)
+{
+    atomic_fetch_add(&timer_calls, 1);
+    assert(atomic_fetch_add(&timer_active, 1) == 0);
+    atomic_store(&monitor_condition, condition);
+    atomic_store(&monitor_thread, pthread_self());
+    int result;
+    if (atomic_exchange(&fail_timer, false)) {
+        result = EINVAL;
+    } else if (atomic_load(&virtual_time)) {
+        int entry = atomic_fetch_add(&waits_entered, 1) + 1;
+        assert(entry < 64);
+        uint64_t ns = (uint64_t)relative->tv_sec * 1000000000 +
+                      (uint64_t)relative->tv_nsec;
+        atomic_store(&requested_delay[entry], ns);
+        while (atomic_load(&allowed_wait) < entry && !atomic_load(&stop_wait)) {
+            assert(pthread_cond_wait(condition, mutex) == 0);
+        }
+        result = 0;
+    } else {
+        result = pthread_cond_timedwait_relative_np(condition, mutex, relative);
+    }
+    assert(atomic_fetch_sub(&timer_active, 1) == 1);
+    return result;
+}
+
+static int checked_broadcast(pthread_cond_t *condition)
+{
+    if (condition == atomic_load(&monitor_condition)) {
+        atomic_store(&stop_wait, true);
+    }
+    return pthread_cond_broadcast(condition);
+}
+
+#define malloc checked_malloc
+#define calloc checked_calloc
+#define free checked_free
+#define clock_gettime checked_clock
+#define pthread_cond_timedwait_relative_np checked_timer
+#define pthread_cond_broadcast checked_broadcast
+#include "../src/close-worker.c"
+#undef malloc
+#undef calloc
+#undef free
+#undef clock_gettime
+#undef pthread_cond_timedwait_relative_np
+#undef pthread_cond_broadcast
+
+#define MAX_ITEMS 5000
+static atomic_int seen[MAX_ITEMS];
+static atomic_int entered;
+static atomic_int finished;
+static atomic_int release_prefix;
+static atomic_int stalled_prefix;
+static atomic_bool release_all;
+static _Atomic(pthread_t) final_worker;
+static pthread_mutex_t release_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t release_changed = PTHREAD_COND_INITIALIZER;
+
+static void release_nodes(int prefix, bool all)
+{
+    pthread_mutex_lock(&release_lock);
+    atomic_store(&release_prefix, prefix);
+    atomic_store(&release_all, all);
+    pthread_cond_broadcast(&release_changed);
+    pthread_mutex_unlock(&release_lock);
+}
+
+static void pause_short(void)
+{
+    const struct timespec pause = { 0, 1000000 };
+    nanosleep(&pause, NULL);
+}
+
+static uint64_t real_ns(void)
+{
+    struct timespec now;
+    assert(clock_gettime(CLOCK_MONOTONIC, &now) == 0);
+    return (uint64_t)now.tv_sec * 1000000000 + (uint64_t)now.tv_nsec;
+}
+
+static void await_count(atomic_int *count, int target)
+{
+    for (unsigned i = 0; i < 10000; i++) {
+        if (atomic_load(count) >= target) {
+            return;
+        }
+        pause_short();
+    }
+    assert(!"adaptive test progress timed out");
+}
+
+static void await_freed(void)
+{
+    for (unsigned i = 0; i < 10000; i++) {
+        if (atomic_load(&allocations) == atomic_load(&frees)) {
+            assert(atomic_load(&timer_active) == 0);
+            return;
+        }
+        pause_short();
+    }
+    assert(!"adaptive pool or record leak");
+}
+
+static int controlled_close(int fd)
+{
+    assert(fd >= 0 && fd < MAX_ITEMS);
+    assert(atomic_fetch_add(&seen[fd], 1) == 0);
+    if (fd == 15) {
+        atomic_store(&final_worker, pthread_self());
+    }
+    atomic_fetch_add(&entered, 1);
+    pthread_mutex_lock(&release_lock);
+    while (fd < atomic_load(&stalled_prefix) &&
+           fd >= atomic_load(&release_prefix) && !atomic_load(&release_all)) {
+        pthread_cond_wait(&release_changed, &release_lock);
+    }
+    pthread_mutex_unlock(&release_lock);
+    atomic_fetch_add(&finished, 1);
+    return 0;
+}
+
+static void reset(bool synthetic_time, int stalled)
+{
+    await_freed();
+    atomic_store(&clock_calls, 0);
+    atomic_store(&timer_calls, 0);
+    atomic_store(&clock_failure, 0);
+    atomic_store(&fail_timer, false);
+    atomic_store(&virtual_time, synthetic_time);
+    atomic_store(&virtual_now, 1000000000);
+    atomic_store(&allowed_wait, 0);
+    atomic_store(&stop_wait, false);
+    atomic_store(&waits_entered, 0);
+    atomic_store(&monitor_condition, NULL);
+    atomic_store(&entered, 0);
+    atomic_store(&finished, 0);
+    atomic_store(&release_prefix, 0);
+    atomic_store(&stalled_prefix, stalled);
+    atomic_store(&release_all, false);
+    for (unsigned i = 0; i < MAX_ITEMS; i++) {
+        atomic_store(&seen[i], 0);
+    }
+    for (unsigned i = 0; i < 64; i++) {
+        atomic_store(&requested_delay[i], 0);
+    }
+}
+
+static void submit_items(SlirpClosePool *pool, unsigned first, unsigned count)
+{
+    for (unsigned i = first; i < first + count; i++) {
+        SlirpCloseTicket *ticket = slirp_close_reserve(pool);
+        assert(ticket);
+        slirp_close_submit(ticket, (int)i);
+    }
+}
+
+static void await_idle(SlirpClosePool *pool)
+{
+    for (unsigned i = 0; i < 10000; i++) {
+        pthread_mutex_lock(&pool->lock);
+        bool idle = !pool->head && !pool->busy && !pool->monitoring &&
+                    pool->sleeping == SLIRP_CLOSE_WORKERS;
+        pthread_mutex_unlock(&pool->lock);
+        if (idle) {
+            return;
+        }
+        pause_short();
+    }
+    assert(!"adaptive pool did not become fully idle");
+}
+
+static void timer_step(SlirpClosePool *pool, int entry, uint64_t now)
+{
+    await_count(&waits_entered, entry);
+    pthread_mutex_lock(&pool->lock);
+    assert(atomic_load(&requested_delay[entry]) > 0);
+    atomic_store(&virtual_now, now);
+    atomic_store(&allowed_wait, entry);
+    pthread_cond_signal(&pool->monitor_changed);
+    pthread_mutex_unlock(&pool->lock);
+}
+
+static void test_deadline_promotion_and_idle(void)
+{
+    reset(true, 16);
+    SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    submit_items(pool, 0, 16);
+    await_count(&waits_entered, 1);
+    assert(atomic_load(&entered) == 1);
+    timer_step(pool, 1, 1000250000);
+    await_count(&waits_entered, 2);
+    assert(atomic_load(&requested_delay[2]) == 750000);
+    timer_step(pool, 2, 1000500000);
+    await_count(&waits_entered, 3);
+    assert(atomic_load(&requested_delay[3]) == 500000);
+    timer_step(pool, 3, 1000999999);
+    await_count(&waits_entered, 4);
+    assert(atomic_load(&requested_delay[4]) == 1);
+    assert(atomic_load(&entered) == 1);
+    timer_step(pool, 4, 1001000000);
+    await_count(&entered, 2);
+    for (int active = 2; active < 16; active++) {
+        timer_step(pool, active + 3, 1000000000 + (uint64_t)active * 1000000);
+        await_count(&entered, active + 1);
+    }
+    assert(pthread_equal(atomic_load(&monitor_thread),
+                         atomic_load(&final_worker)));
+    pthread_mutex_lock(&pool->lock);
+    assert(pool->busy == 16 && pool->service_limit == 16 && !pool->monitoring);
+    pthread_mutex_unlock(&pool->lock);
+    release_nodes(15, false);
+    await_count(&finished, 15);
+    for (unsigned i = 0; i < 10000; i++) {
+        pthread_mutex_lock(&pool->lock);
+        bool one = pool->busy == 1;
+        assert(pool->service_limit == 16);
+        pthread_mutex_unlock(&pool->lock);
+        if (one) {
+            break;
+        }
+        pause_short();
+        assert(i != 9999);
+    }
+    release_nodes(0, true);
+    await_count(&finished, 16);
+    await_idle(pool);
+    pthread_mutex_lock(&pool->lock);
+    assert(pool->service_limit == 1);
+    pthread_mutex_unlock(&pool->lock);
+    int clocks = atomic_load(&clock_calls);
+    int timers = atomic_load(&timer_calls);
+    for (unsigned i = 0; i < 20; i++) {
+        pause_short();
+    }
+    assert(clocks == atomic_load(&clock_calls));
+    assert(timers == atomic_load(&timer_calls));
+    slirp_close_pool_free(pool);
+    await_freed();
+    puts("PASS: fixed 1ms deadline survives three early wakes; each quiet "
+         "interval promotes one; monitor becomes worker16; true idle resets "
+         "and has no timer polling");
+}
+
+static void test_completion_defers_promotion(void)
+{
+    reset(true, MAX_ITEMS);
+    SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    submit_items(pool, 0, 32);
+    await_count(&waits_entered, 1);
+    release_nodes(1, false);
+    await_count(&entered, 2);
+    timer_step(pool, 1, 1001000000);
+    await_count(&waits_entered, 2);
+    pthread_mutex_lock(&pool->lock);
+    assert(pool->completed == 1 && pool->busy == 1 && pool->service_limit == 1);
+    pthread_mutex_unlock(&pool->lock);
+    timer_step(pool, 2, 1002000000);
+    await_count(&entered, 3);
+    pthread_mutex_lock(&pool->lock);
+    assert(pool->service_limit == 2);
+    pthread_mutex_unlock(&pool->lock);
+    slirp_close_pool_free(pool);
+    await_count(&entered, 17);
+    release_nodes(0, true);
+    await_freed();
+    assert(atomic_load(&finished) == 32);
+    puts("PASS: a real completion defers promotion for one observation "
+         "interval; the next quiet interval promotes; shutdown bypasses "
+         "remaining timers");
+}
+
+static void test_cleanup_wakes_frozen_monitor(void)
+{
+    reset(true, MAX_ITEMS);
+    SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    submit_items(pool, 0, 64);
+    await_count(&waits_entered, 1);
+    assert(atomic_load(&entered) == 1);
+    slirp_close_pool_free(pool);
+    await_count(&entered, 16);
+    assert(atomic_load(&virtual_now) == 1000000000);
+    assert(atomic_load(&waits_entered) == 1);
+    release_nodes(0, true);
+    await_freed();
+    assert(atomic_load(&finished) == 64);
+    int timers = atomic_load(&timer_calls);
+    pause_short();
+    assert(timers == atomic_load(&timer_calls));
+    puts("PASS: cleanup interrupts a frozen monitor and starts all16 closes "
+         "without advancing time; full drain leaves no timer work");
+}
+
+static void test_timing_failures(void)
+{
+    for (int mode = 1; mode <= 5; mode++) {
+        reset(false, MAX_ITEMS);
+        if (mode <= 4) {
+            atomic_store(&clock_failure, mode);
+        } else {
+            atomic_store(&fail_timer, true);
+        }
+        SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+        assert(pool);
+        submit_items(pool, 0, 32);
+        await_count(&entered, 16);
+        pthread_mutex_lock(&pool->lock);
+        assert(pool->timer_failed && pool->service_limit == 16);
+        pthread_mutex_unlock(&pool->lock);
+        release_nodes(0, true);
+        await_count(&finished, 32);
+        await_idle(pool);
+        pthread_mutex_lock(&pool->lock);
+        assert(pool->timer_failed && pool->service_limit == 16);
+        pthread_mutex_unlock(&pool->lock);
+        int clocks = atomic_load(&clock_calls);
+        submit_items(pool, 32, 1);
+        await_count(&finished, 33);
+        await_idle(pool);
+        assert(clocks == atomic_load(&clock_calls));
+        slirp_close_pool_free(pool);
+        await_freed();
+    }
+    puts("PASS: clock error, negative time, invalid nanoseconds, time overflow "
+         "and timer error preserve async full-pool service without retry "
+         "polling");
+}
+
+static void test_native_mixed_loads(void)
+{
+    const unsigned stalled[] = { 1, 8, 15 };
+    for (unsigned run = 0; run < sizeof(stalled) / sizeof(stalled[0]); run++) {
+        unsigned n = stalled[run];
+        reset(false, (int)n);
+        SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+        assert(pool);
+        uint64_t start = real_ns();
+        submit_items(pool, 0, n + 4000);
+        await_count(&finished, 4000);
+        pthread_mutex_lock(&pool->lock);
+        assert(pool->busy == n && !pool->head && !pool->timer_failed);
+        unsigned limit = pool->service_limit;
+        pthread_mutex_unlock(&pool->lock);
+        uint64_t elapsed = real_ns() - start;
+        assert(atomic_load(&entered) == (int)n + 4000);
+        submit_items(pool, n + 4000, 32);
+        await_count(&finished, 4032);
+        slirp_close_pool_free(pool);
+        release_nodes(0, true);
+        await_freed();
+        assert(atomic_load(&finished) == (int)n + 4032);
+        printf(
+            "PASS: native mixed load holds %u closes while 4032 fast records "
+            "drain; first 4000 took %.3fms, service limit %u, timer waits %d\n",
+            n, (double)elapsed / 1000000, limit, atomic_load(&timer_calls));
+    }
+}
+
+int main(void)
+{
+    alarm(90);
+    test_deadline_promotion_and_idle();
+    test_completion_defers_promotion();
+    test_cleanup_wakes_frozen_monitor();
+    test_timing_failures();
+    test_native_mixed_loads();
+    await_freed();
+    return 0;
+}
