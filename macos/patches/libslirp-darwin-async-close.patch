+
+static int failure;
+static atomic_int allocations, frees, mutex_inits, mutex_destroys;
+static atomic_int cond_inits, cond_destroys, attr_inits, attr_destroys;
+static atomic_int setclock_calls, create_calls, worker_returns;
+static atomic_int timer_calls, timer_timeouts;
+static pthread_cond_t *monitor_condition;
+
+static void *tracked_malloc(size_t size)
+{
+    void *p = malloc(size);
+    if (p) {
+        atomic_fetch_add(&allocations, 1);
+    }
+    return p;
+}
+
+static void *tracked_calloc(size_t count, size_t size)
+{
+    void *p = calloc(count, size);
+    if (p) {
+        atomic_fetch_add(&allocations, 1);
+    }
+    return p;
+}
+
+static void tracked_free(void *p)
+{
+    if (p) {
+        free(p);
+        atomic_fetch_add(&frees, 1);
+    }
+}
+
+static int tracked_mutex_init(pthread_mutex_t *p, const pthread_mutexattr_t *a)
+{
+    int result = pthread_mutex_init(p, a);
+    assert(result == 0);
+    atomic_fetch_add(&mutex_inits, 1);
+    return result;
+}
+
+static int tracked_mutex_destroy(pthread_mutex_t *p)
+{
+    int result = pthread_mutex_destroy(p);
+    assert(result == 0);
+    atomic_fetch_add(&mutex_destroys, 1);
+    return result;
+}
+
+static int tracked_condattr_init(pthread_condattr_t *attr)
+{
+    if (failure == 1) {
+        return EAGAIN;
+    }
+    int result = pthread_condattr_init(attr);
+    assert(result == 0);
+    atomic_fetch_add(&attr_inits, 1);
+    return result;
+}
+
+static int tracked_condattr_setclock(pthread_condattr_t *attr, clockid_t clock)
+{
+    assert(clock == CLOCK_MONOTONIC);
+    atomic_fetch_add(&setclock_calls, 1);
+    return failure == 2 ? ENOTSUP : pthread_condattr_setclock(attr, clock);
+}
+
+static int tracked_condattr_destroy(pthread_condattr_t *attr)
+{
+    int result = pthread_condattr_destroy(attr);
+    assert(result == 0);
+    atomic_fetch_add(&attr_destroys, 1);
+    return result;
+}
+
+static int tracked_cond_init(pthread_cond_t *p, const pthread_condattr_t *attr)
+{
+    if (attr) {
+        clockid_t clock;
+        assert(pthread_condattr_getclock(attr, &clock) == 0);
+        assert(clock == CLOCK_MONOTONIC);
+        if (failure == 3) {
+            return EINVAL;
+        }
+    }
+    int result = pthread_cond_init(p, attr);
+    assert(result == 0);
+    atomic_fetch_add(&cond_inits, 1);
+    if (attr) {
+        monitor_condition = p;
+    }
+    return result;
+}
+
+static int tracked_cond_destroy(pthread_cond_t *p)
+{
+    int result = pthread_cond_destroy(p);
+    assert(result == 0);
+    atomic_fetch_add(&cond_destroys, 1);
+    return result;
+}
+
+struct Start {
+    void *(*run)(void *);
+    void *arg;
+};
+static struct Start starts[16];
+
+static void *tracked_start(void *opaque)
+{
+    struct Start *start = opaque;
+    void *result = start->run(start->arg);
+    atomic_fetch_add(&worker_returns, 1);
+    return result;
+}
+
+static int tracked_create(pthread_t *thread, const pthread_attr_t *attr,
+                          void *(*run)(void *), void *arg)
+{
+    int i = atomic_fetch_add(&create_calls, 1);
+    assert(i < 16);
+    starts[i] = (struct Start){ run, arg };
+    return pthread_create(thread, attr, tracked_start, &starts[i]);
+}
+
+static int tracked_timedwait(pthread_cond_t *condition, pthread_mutex_t *mutex,
+                             const struct timespec *deadline)
+{
+    assert(condition == monitor_condition);
+    assert(deadline->tv_sec >= 0);
+    assert(deadline->tv_nsec >= 0 && deadline->tv_nsec < 1000000000);
+    struct timespec now;
+    assert(clock_gettime(CLOCK_MONOTONIC, &now) == 0);
+    /* An accidental realtime absolute deadline is far beyond this bound. */
+    assert(deadline->tv_sec <= now.tv_sec + 1);
+    atomic_fetch_add(&timer_calls, 1);
+    int result = pthread_cond_timedwait(condition, mutex, deadline);
+    assert(result == 0 || result == ETIMEDOUT);
+    if (result == ETIMEDOUT) {
+        atomic_fetch_add(&timer_timeouts, 1);
+    }
+    return result;
+}
+
+#define malloc tracked_malloc
+#define calloc tracked_calloc
+#define free tracked_free
+#define pthread_mutex_init tracked_mutex_init
+#define pthread_mutex_destroy tracked_mutex_destroy
+#define pthread_condattr_init tracked_condattr_init
+#define pthread_condattr_setclock tracked_condattr_setclock
+#define pthread_condattr_destroy tracked_condattr_destroy
+#define pthread_cond_init tracked_cond_init
+#define pthread_cond_destroy tracked_cond_destroy
+#define pthread_create tracked_create
+#define pthread_cond_timedwait tracked_timedwait
+#include "../src/close-worker.c"
+#undef malloc
+#undef calloc
+#undef free
+#undef pthread_mutex_init
+#undef pthread_mutex_destroy
+#undef pthread_condattr_init
+#undef pthread_condattr_setclock
+#undef pthread_condattr_destroy
+#undef pthread_cond_init
+#undef pthread_cond_destroy
+#undef pthread_create
+#undef pthread_cond_timedwait
+
+static void reset(void)
+{
+    atomic_store(&allocations, 0);
+    atomic_store(&frees, 0);
+    atomic_store(&mutex_inits, 0);
+    atomic_store(&mutex_destroys, 0);
+    atomic_store(&cond_inits, 0);
+    atomic_store(&cond_destroys, 0);
+    atomic_store(&attr_inits, 0);
+    atomic_store(&attr_destroys, 0);
+    atomic_store(&setclock_calls, 0);
+    atomic_store(&create_calls, 0);
+    atomic_store(&worker_returns, 0);
+    atomic_store(&timer_calls, 0);
+    atomic_store(&timer_timeouts, 0);
+    monitor_condition = NULL;
+}
+
+static int unused_close(int fd)
+{
+    (void)fd;
+    assert(!"failed initialization must not close a descriptor");
+    return 0;
+}
+
+static void initialization_failures(void)
+{
+    const int expected_error[] = { 0, EAGAIN, ENOTSUP, EINVAL };
+    for (failure = 1; failure <= 3; failure++) {
+        reset();
+        errno = 0;
+        assert(slirp_close_pool_new(unused_close) == NULL);
+        assert(errno == expected_error[failure]);
+        assert(atomic_load(&allocations) == 1 && atomic_load(&frees) == 1);
+        assert(atomic_load(&mutex_inits) == 1 &&
+               atomic_load(&mutex_destroys) == 1);
+        assert(atomic_load(&cond_inits) == 1 &&
+               atomic_load(&cond_destroys) == 1);
+        int attributes = failure == 1 ? 0 : 1;
+        assert(atomic_load(&attr_inits) == attributes);
+        assert(atomic_load(&attr_destroys) == attributes);
+        assert(atomic_load(&setclock_calls) == attributes);
+        assert(atomic_load(&create_calls) == 0);
+        assert(monitor_condition == NULL);
+        printf("PASS: Linux monitor initialization failure %d preserves errno "
+               "and exactly releases prior resources\n",
+               failure);
+    }
+    failure = 0;
+}
+
+static pthread_mutex_t gate = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t changed = PTHREAD_COND_INITIALIZER;
+static atomic_int entered, finished;
+static bool release_closes;
+
+static int held_close(int fd)
+{
+    assert(fd >= 0 && fd < SLIRP_CLOSE_WORKERS);
+    assert(pthread_mutex_lock(&gate) == 0);
+    atomic_fetch_add(&entered, 1);
+    while (!release_closes) {
+        assert(pthread_cond_wait(&changed, &gate) == 0);
+    }
+    atomic_fetch_add(&finished, 1);
+    assert(pthread_mutex_unlock(&gate) == 0);
+    return 0;
+}
+
+static void await_count(atomic_int *count, int expected)
+{
+    const struct timespec delay = { 0, 1000000 };
+    for (int i = 0; i < 10000; i++) {
+        if (atomic_load(count) == expected) {
+            return;
+        }
+        nanosleep(&delay, NULL);
+    }
+    assert(!"Linux monitor fixture did not complete within its bounded wait");
+}
+
+static void monotonic_promotion(void)
