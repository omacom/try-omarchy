+        atomic_store(&hold_ready, true);
+        SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+        assert(pool);
+        await_sleeping(pool);
+        if (multiple) {
+            pthread_mutex_lock(&pool->lock);
+            os_sync_wake_by_address_all(&pool->ready_generation, 8,
+                                        OS_SYNC_WAKE_BY_ADDRESS_NONE);
+            pthread_mutex_unlock(&pool->lock);
+            await_count(&ready_held, 2);
+        }
+        slirp_close_pool_free(pool);
+        await_count(&ready_held, 1);
+        assert(atomic_load(&returned_threads) == 0);
+        assert(atomic_load(&allocations) > atomic_load(&frees));
+        gate_release(&hold_ready);
+        await_drain(0);
+        assert(atomic_load(&ready_signals) > 0);
+    }
+    puts("PASS: empty stopped queue and multiple delayed exit paths drain");
+}
+
+static void backlog_and_pending_wakes(void)
+{
+    reset(1);
+    atomic_store(&hold_ready, true);
+    SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    await_sleeping(pool);
+    submit(pool, ITEMS);
+    await_count(&ready_held, 1);
+    pthread_mutex_lock(&pool->lock);
+    assert(pool->wake_pending && pool->busy == 0);
+    os_sync_wake_by_address_all(&pool->ready_generation, 8,
+                                OS_SYNC_WAKE_BY_ADDRESS_NONE);
+    pthread_mutex_unlock(&pool->lock);
+    await_count(&ready_held, 2);
+    slirp_close_pool_free(pool);
+    gate_release(&hold_ready);
+    await_count(&entered, ITEMS);
+    await_count(&finished, ITEMS - 1);
+    assert(atomic_load(&finished) == ITEMS - 1);
+    assert(atomic_load(&allocations) > atomic_load(&frees));
+    release_callbacks();
+    await_drain(ITEMS);
+    puts("PASS: stale pending and spurious returns cannot strand backlog "
+         "behind first blocked close");
+}
+
+static void cascade_before_blocked_close(void)
+{
+    reset(SLIRP_CLOSE_WORKERS);
+    atomic_store(&hold_ready, true);
+    SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    await_sleeping(pool);
+    submit(pool, ITEMS);
+    await_count(&ready_held, 1);
+    slirp_close_pool_free(pool);
+    assert(atomic_load(&ready_signals) == 2);
+    assert(atomic_load(&entered) == 0);
+    gate_release(&hold_ready);
+    await_count(&entered, SLIRP_CLOSE_WORKERS);
+    assert(atomic_load(&finished) == 0);
+    assert(atomic_load(&allocations) > atomic_load(&frees));
+    release_callbacks();
+    await_drain(ITEMS);
+    puts("PASS: shutdown cascade reaches all 16 blocked closes without a ready "
+         "broadcast");
+}
+
+static void monitor_handoffs(void)
+{
+    reset(1);
+    atomic_store(&hold_clock, true);
+    atomic_store(&hold_ready, true);
+    SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    await_sleeping(pool);
+    submit(pool, ITEMS);
+    gate_release(&hold_ready);
+    await_count(&clock_held, 1);
+    pthread_t owner;
+    assert(pthread_create(&owner, NULL, cleanup, pool) == 0);
+    while (!atomic_load(&cleanup_started)) {
+        pause_short();
+    }
+    assert(!atomic_load(&cleanup_returned));
+    gate_release(&hold_clock);
+    assert(pthread_join(owner, NULL) == 0);
+    await_count(&finished, ITEMS - 1);
+    release_callbacks();
+    await_drain(ITEMS);
+
+    reset(1);
+    atomic_store(&hold_monitor, true);
+    pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    submit(pool, ITEMS);
+    await_count(&monitor_held, 1);
+    slirp_close_pool_free(pool);
+    await_count(&finished, ITEMS - 1);
+    release_callbacks();
+    await_count(&finished, ITEMS);
+    assert(atomic_load(&allocations) > atomic_load(&frees));
+    gate_release(&hold_monitor);
+    await_drain(ITEMS);
+    puts("PASS: monitor start handoff and delayed native timer return preserve "
+         "cleanup lifetime");
+}
+
+static void completion_and_all_blocked(void)
+{
+    reset(0);
+    atomic_store(&hold_completion, true);
+    SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    submit(pool, 1);
+    await_count(&completion_held, 1);
+    slirp_close_pool_free(pool);
+    await_count(&returned_threads, SLIRP_CLOSE_WORKERS - 1);
+    assert(atomic_load(&allocations) > atomic_load(&frees));
+    gate_release(&hold_completion);
+    await_drain(1);
+
+    reset(SLIRP_CLOSE_WORKERS);
+    pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    submit(pool, ITEMS);
+    await_count(&entered, SLIRP_CLOSE_WORKERS);
+    assert(atomic_load(&finished) == 0);
+    slirp_close_pool_free(pool);
+    assert(atomic_load(&returned_threads) == 0);
+    assert(atomic_load(&allocations) > atomic_load(&frees));
+    release_callbacks();
+    await_drain(ITEMS);
+    puts("PASS: completion handoff and all 16 held closes retain pool until "
+         "complete drain");
+}
+
+static void monitor_initialization_failure(void)
+{
+    reset(0);
+    int allocated_before = atomic_load(&allocations);
+    int freed_before = atomic_load(&frees);
+    atomic_store(&fail_monitor_init, true);
+    errno = 0;
+    assert(slirp_close_pool_new(controlled_close) == NULL);
+    assert(errno == EINVAL);
+    assert(atomic_load(&allocations) == allocated_before + 1);
+    assert(atomic_load(&frees) == freed_before + 1);
+    assert(atomic_load(&condition_inits) == 1);
+    assert(atomic_load(&condition_destroys) == 1);
+    assert(atomic_load(&mutex_inits) == 1);
+    assert(atomic_load(&mutex_destroys) == 1);
+    assert(atomic_load(&create_attempts) == 0);
+    assert(atomic_load(&successful_threads) == 0);
+    assert(atomic_load(&native_wait_calls) == 0);
+    await_drain(0);
+    puts("PASS: native monitor condition initialization failure preserves "
+         "errno and releases the ready condition, mutex and pool");
+}
+
+static void partial_creation(void)
+{
+    for (int failure = 1; failure <= SLIRP_CLOSE_WORKERS; failure++) {
+        reset(0);
+        atomic_store(&fail_create, failure);
+        assert(slirp_close_pool_new(controlled_close) == NULL);
+        assert(errno == EAGAIN);
+        assert(atomic_load(&successful_threads) == failure - 1);
+        await_drain(0);
+    }
+    puts("PASS: every partial worker-creation failure drains the shutdown "
+         "baton");
+}
+
+static void assert_native(SlirpClosePool *pool)
+{
+    pthread_mutex_lock(&pool->lock);
+    assert(!pool->ready_fallback);
+    assert(__atomic_load_n(&pool->ready_generation, __ATOMIC_RELAXED) !=
+           UINT64_MAX);
+    pthread_mutex_unlock(&pool->lock);
+    assert(atomic_load(&native_entries) > 0);
+}
+
+static void missing_entry(void)
+{
+    reset(0);
+    atomic_store(&hold_entry, true);
+    atomic_store(&entry_hold_budget, SLIRP_CLOSE_WORKERS);
+    SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    await_count(&entry_held, SLIRP_CLOSE_WORKERS);
+    assert(atomic_load(&native_entries) == 0);
+    SlirpCloseTicket *ticket = slirp_close_reserve(pool);
+    assert(ticket);
+    errno = EBUSY;
+    slirp_close_submit(ticket, 0);
+    assert(errno == EBUSY && atomic_load(&native_enoent) == 1);
+    gate_release(&hold_entry);
+    await_count(&finished, 1);
+    assert_native(pool);
+    slirp_close_pool_free(pool);
+    await_drain(1);
+    printf("PASS: publication before kernel entry progresses after ENOENT; "
+           "native calls=%d fallback=0\n",
+           atomic_load(&native_entries));
+}
+
+static void positive_and_interrupted_returns(void)
+{
+    reset(0);
+    atomic_store(&force_positive, true);
+    SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    await_sleeping(pool);
+    submit(pool, ITEMS);
+    await_count(&finished, ITEMS);
+    assert_native(pool);
+    assert(atomic_load(&positive_returns) > 0);
+    slirp_close_pool_free(pool);
+    await_drain(ITEMS);
+    puts("PASS: positive native waiter-count returns are successful and "
+         "preserve native mode");
+
+    const int interruptions[] = { 1, 8 };
+    for (unsigned i = 0; i < sizeof(interruptions) / sizeof(interruptions[0]);
+         i++) {
+        reset(0);
+        atomic_store(&interrupt_budget, interruptions[i]);
+        pool = slirp_close_pool_new(controlled_close);
+        assert(pool);
+        await_count(&interrupted_returns, interruptions[i]);
+        await_sleeping(pool);
+        submit(pool, ITEMS);
+        await_count(&finished, ITEMS);
+        assert_native(pool);
+        slirp_close_pool_free(pool);
+        await_drain(ITEMS);
+    }
+    puts("PASS: one and eight interrupted waits recheck predicates and return "
+         "to native blocking without fallback");
+}
+
+static void confirm_kernel_sleepers(SlirpClosePool *pool)
+{
+    for (unsigned i = 0; i < 10000; i++) {
+        if (atomic_load(&native_positive) > 0) {
+            return;
+        }
+        int result = os_sync_wake_by_address_any(&pool->ready_generation, 8,
+                                                 OS_SYNC_WAKE_BY_ADDRESS_NONE);
+        assert(result == 0 || errno == ENOENT);
+        pause_short();
+    }
+    assert(!"no positive native waiter count observed");
+}
+
+static void await_fallback(SlirpClosePool *pool)
+{
+    for (unsigned i = 0; i < 10000; i++) {
+        pthread_mutex_lock(&pool->lock);
+        bool fallback = pool->ready_fallback;
+        if (fallback) {
+            assert(__atomic_load_n(&pool->ready_generation, __ATOMIC_RELAXED) ==
+                   UINT64_MAX);
+        }
+        pthread_mutex_unlock(&pool->lock);
+        if (fallback) {
+            return;
+        }
+        pause_short();
+    }
+    assert(!"native wait did not switch to fallback");
+}
+
+static void mixed_fallback_and_saturation(void)
+{
+    const int errors[] = { ENOMEM, EFAULT, EINVAL, 0 };
+    for (unsigned i = 0; i < sizeof(errors) / sizeof(errors[0]); i++) {
+        reset(0);
+        expected_fallbacks = 1;
+        atomic_store(&hold_entry, true);
+        atomic_store(&entry_hold_budget, 1);
+        atomic_store(&hold_ready, true);
+        atomic_store(&hold_start, true);
+        SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+        assert(pool);
+        await_count(&start_held, SLIRP_CLOSE_WORKERS);
+        if (!errors[i]) {
+            pthread_mutex_lock(&pool->lock);
+            __atomic_store_n(&pool->ready_generation, UINT64_MAX - 1,
+                             __ATOMIC_RELEASE);
+            pthread_mutex_unlock(&pool->lock);
+        }
+        gate_release(&hold_start);
+        await_count(&entry_held, 1);
+        await_count(&native_entries, SLIRP_CLOSE_WORKERS - 1);
+        confirm_kernel_sleepers(pool);
+        if (errors[i]) {
+            atomic_store(&fail_wait_after, errors[i]);
+        }
+        submit(pool, 1);
+        await_fallback(pool);
+        gate_release(&hold_entry);
+        gate_release(&hold_ready);
+        await_count(&finished, 1);
+        await_sleeping(pool);
+        int calls = atomic_load(&native_wait_calls);
+        for (int fd = 1; fd < ITEMS; fd++) {
+            SlirpCloseTicket *ticket = slirp_close_reserve(pool);
+            assert(ticket);
+            slirp_close_submit(ticket, fd);
+        }
+        await_count(&finished, ITEMS);
+        assert(atomic_load(&native_wait_calls) == calls);
+        slirp_close_pool_free(pool);
+        await_drain(ITEMS);
+        printf(
+            "PASS: error=%d transitions once with real sleepers and a delayed "
+            "entrant; terminal generation, later admission and full drain\n",
+            errors[i]);
+    }
+}
+
+static void notifier_lifetime(void)
+{
+    reset(0);
+    SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    await_sleeping(pool);
+    atomic_store(&hold_wake_at, 2);
+    atomic_store(&hold_wake, true);
+    slirp_close_pool_free(pool);
+    await_count(&wake_held, 1);
+    assert(atomic_load(&allocations) > atomic_load(&frees));
+    gate_release(&hold_wake);
+    await_drain(0);
+    puts("PASS: worker reference and queue lock protect native wake after "
+         "owner cleanup returns");
+}
+
+static void invalid_wake(void)
+{
+    reset(0);
+    SlirpClosePool *pool = slirp_close_pool_new(controlled_close);
+    assert(pool);
+    await_sleeping(pool);
+    atomic_store(&fail_wake, EINVAL);
+    submit(pool, 1);
+    assert(!"invalid native wake was silently accepted");
+}
+
+int main(int argc, char **argv)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    if (argc == 2 && strcmp(argv[1], "--missing-entry") == 0) {
+        missing_entry();
+        return 0;
+    }
+    if (argc == 2 && strcmp(argv[1], "--cascade") == 0) {
+        cascade_before_blocked_close();
+        return 0;
+    }
+    if (argc == 2 && strcmp(argv[1], "--wake-error") == 0) {
+        invalid_wake();
+        return 1;
+    }
+    missing_entry();
+    positive_and_interrupted_returns();
+    mixed_fallback_and_saturation();
+    notifier_lifetime();
+    empty_and_multiple_returns();
+    backlog_and_pending_wakes();
+    cascade_before_blocked_close();
+    monitor_handoffs();
+    completion_and_all_blocked();
+    monitor_initialization_failure();
+    partial_creation();
+    return 0;
+}
diff --git a/test/close-worker-linux-monitor-test.c b/test/close-worker-linux-monitor-test.c
